+//go:build linux
+
+package isolation
+
+import "os"
+
+// Linux access ACL masks are reflected in the group class mode bits. The
+// shared group/other-writable check therefore rejects ACLs that grant write
+// access to another principal without requiring a platform ACL parser.
+func validatePlatformTrust(_ string, _ os.FileInfo) error {
+	return nil
+}
diff --git a/apps/cli-go/internal/utils/isolation/hostsource_trust_unix.go b/apps/cli-go/internal/utils/isolation/hostsource_trust_unix.go
new file mode 100644
index 0000000..03db2c4
--- /dev/null
+++ b/apps/cli-go/internal/utils/isolation/hostsource_trust_unix.go
@@ -0,0 +1,76 @@
+//go:build darwin || linux
+
+package isolation
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+)
+
+func validateTrustedComponents(components []hostComponent) error {
+	effectiveUser := uint32(os.Geteuid())
+	for index, component := range components {
+		if err := validatePlatformTrust(component.path, component.info); err != nil {
+			return err
+		}
+		owner, err := componentOwner(component.info)
+		if err != nil {
+			return fmt.Errorf("inspect host bind source ownership at %s: %w", component.path, err)
+		}
+		if !isTrustedOwner(owner, effectiveUser) {
+			return fmt.Errorf("host bind source component is owned by an untrusted principal: %s", component.path)
+		}
+		if !component.info.IsDir() {
+			continue
+		}
+		untrustedWrite := component.info.Mode().Perm() & 0o022
+		if untrustedWrite == 0 {
+			continue
+		}
+		if index == len(components)-1 {
+			return fmt.Errorf("host bind directory is writable by an untrusted principal: %s", component.path)
+		}
+		if component.info.Mode()&os.ModeSticky == 0 {
+			return fmt.Errorf("host bind parent is replaceable by an untrusted principal: %s", component.path)
+		}
+		nextOwner, err := componentOwner(components[index+1].info)
+		if err != nil {
+			return fmt.Errorf("inspect host bind child ownership at %s: %w", components[index+1].path, err)
+		}
+		if nextOwner != 0 && nextOwner != effectiveUser {
+			return fmt.Errorf("host bind child in sticky parent is owned by an untrusted principal: %s", components[index+1].path)
+		}
+	}
+	return nil
+}
+
+func componentOwner(info os.FileInfo) (uint32, error) {
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return 0, fmt.Errorf("unsupported file ownership metadata")
+	}
+	return stat.Uid, nil
+}
+
+func validateTrustedTreeEntry(path string, info os.FileInfo) error {
+	if err := validatePlatformTrust(path, info); err != nil {
+		return err
+	}
+	owner, err := componentOwner(info)
+	if err != nil {
+		return fmt.Errorf("inspect host bind directory ownership at %s: %w", path, err)
+	}
+	effectiveUser := uint32(os.Geteuid())
+	if !isTrustedOwner(owner, effectiveUser) {
+		return fmt.Errorf("host bind directory entry is owned by an untrusted principal: %s", path)
+	}
+	if info.IsDir() && info.Mode().Perm()&0o022 != 0 {
+		return fmt.Errorf("host bind directory tree is writable by an untrusted principal: %s", path)
+	}
+	return nil
+}
+
+func isTrustedOwner(owner, effectiveUser uint32) bool {
+	return owner == 0 || owner == effectiveUser
+}
