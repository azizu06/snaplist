+	"github.com/docker/docker/api/types/network"
+	"github.com/docker/docker/client"
+	"github.com/stretchr/testify/require"
+)
+
+type countingRoundTripper struct {
+	calls int
+}
+
+func (transport *countingRoundTripper) RoundTrip(*http.Request) (*http.Response, error) {
+	transport.calls++
+	return &http.Response{
+		StatusCode: http.StatusInternalServerError,
+		Body:       io.NopCloser(strings.NewReader("unexpected Docker action")),
+		Header:     make(http.Header),
+	}, nil
+}
+
+type safeCachedImageRoundTripper struct {
+	imageInspect    int
+	imagePull       int
+	volumeCreate    int
+	containerCreate int
+	containerStart  int
+	other           int
+}
+
+type replacingHostSourceRoundTripper struct {
+	t               *testing.T
+	source          string
+	replacement     string
+	imageInspect    int
+	containerCreate int
+	containerStart  int
+	other           int
+}
+
+func (transport *replacingHostSourceRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	status := http.StatusInternalServerError
+	body := "unexpected Docker action"
+	switch {
+	case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/images/") && strings.HasSuffix(request.URL.Path, "/json"):
+		transport.imageInspect++
+		require.NoError(transport.t, os.RemoveAll(transport.source))
+		require.NoError(transport.t, os.Symlink(transport.replacement, transport.source))
+		status = http.StatusOK
+		body = "{}"
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/containers/create"):
+		transport.containerCreate++
+		status = http.StatusCreated
+		body = `{"Id":"unsafe-container","Warnings":[]}`
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/start"):
+		transport.containerStart++
+		status = http.StatusNoContent
+		body = ""
+	default:
+		transport.other++
+	}
+	return &http.Response{
+		StatusCode: status,
+		Body:       io.NopCloser(strings.NewReader(body)),
+		Header:     make(http.Header),
+	}, nil
+}
+
+func (transport *safeCachedImageRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	status := http.StatusInternalServerError
+	body := "unexpected Docker action"
+	switch {
+	case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/images/") && strings.HasSuffix(request.URL.Path, "/json"):
+		transport.imageInspect++
+		status = http.StatusOK
+		body = "{}"
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/images/create"):
+		transport.imagePull++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/volumes/create"):
+		transport.volumeCreate++
+		status = http.StatusCreated
+		body = `{}`
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/containers/create"):
+		transport.containerCreate++
+		status = http.StatusCreated
+		body = `{"Id":"safe-container","Warnings":[]}`
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/start"):
+		transport.containerStart++
+		status = http.StatusNoContent
+		body = ""
+	default:
+		transport.other++
+	}
+	return &http.Response{
+		StatusCode: status,
+		Body:       io.NopCloser(strings.NewReader(body)),
+		Header:     make(http.Header),
+	}, nil
+}
