+type databaseDockerActionCounter struct {
+	volumeInspect   int
+	imageInspect    int
+	imagePull       int
+	networkCreate   int
+	volumeCreate    int
+	containerCreate int
+	other           int
+	onVolumeInspect func()
+}
+
+type databaseBindCaptureTransport struct {
+	hostConfig     container.HostConfig
+	backupSource   string
+	backupType     string
+	backupContents []byte
+	captureErr     error
+}
+
+func (transport *databaseBindCaptureTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	status := http.StatusCreated
+	body := `{}`
+	switch {
+	case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/volumes/"):
+		status = http.StatusNotFound
+		body = `{"message":"not found"}`
+	case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/images/") && strings.HasSuffix(request.URL.Path, "/json"):
+		status = http.StatusOK
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/containers/create"):
+		var requestBody struct {
+			HostConfig container.HostConfig
+		}
+		if err := json.NewDecoder(request.Body).Decode(&requestBody); err != nil {
+			return nil, err
+		}
+		transport.hostConfig = requestBody.HostConfig
+		for _, bind := range transport.hostConfig.Binds {
+			parsed, err := loader.ParseVolume(bind)
+			if err != nil {
+				transport.captureErr = err
+				break
+			}
+			if parsed.Target == "/etc/backup.sql" {
+				transport.backupSource = parsed.Source
+				transport.backupType = parsed.Type
+				transport.backupContents, transport.captureErr = os.ReadFile(parsed.Source)
+				break
+			}
+		}
+		status = http.StatusInternalServerError
+		body = `{"message":"stop after capture"}`
+	}
+	return &http.Response{
+		StatusCode: status,
+		Body:       io.NopCloser(strings.NewReader(body)),
+		Header:     make(http.Header),
+	}, nil
+}
+
+func (counter *databaseDockerActionCounter) RoundTrip(request *http.Request) (*http.Response, error) {
+	switch {
+	case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/volumes/"):
+		counter.volumeInspect++
+		if counter.onVolumeInspect != nil {
+			counter.onVolumeInspect()
+		}
+	case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/images/") && strings.HasSuffix(request.URL.Path, "/json"):
+		counter.imageInspect++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/images/create"):
+		counter.imagePull++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/networks/create"):
+		counter.networkCreate++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/volumes/create"):
+		counter.volumeCreate++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/containers/create"):
+		counter.containerCreate++
+	default:
+		counter.other++
+	}
+	return &http.Response{
+		StatusCode: http.StatusInternalServerError,
+		Body:       io.NopCloser(strings.NewReader("unexpected Docker action")),
+		Header:     make(http.Header),
+	}, nil
+}
