@@ -0,0 +1,189 @@
+package start
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/docker/docker/client"
+	"github.com/spf13/afero"
+	"github.com/stretchr/testify/require"
+
+	"github.com/supabase/cli/internal/utils"
+	"github.com/supabase/cli/pkg/config"
+)
+
+type databaseDockerActionCounter struct {
+	volumeInspect   int
+	imageInspect    int
+	imagePull       int
+	networkCreate   int
+	volumeCreate    int
+	containerCreate int
+	other           int
+}
+
+func (counter *databaseDockerActionCounter) RoundTrip(request *http.Request) (*http.Response, error) {
+	switch {
+	case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/volumes/"):
+		counter.volumeInspect++
+	case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/images/") && strings.HasSuffix(request.URL.Path, "/json"):
+		counter.imageInspect++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/images/create"):
+		counter.imagePull++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/networks/create"):
+		counter.networkCreate++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/volumes/create"):
+		counter.volumeCreate++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/containers/create"):
+		counter.containerCreate++
+	default:
+		counter.other++
+	}
+	return &http.Response{
+		StatusCode: http.StatusInternalServerError,
+		Body:       io.NopCloser(strings.NewReader("unexpected Docker action")),
+		Header:     make(http.Header),
+	}, nil
+}
+
+func TestStartDatabaseRejectsUnsafeDerivedConfigBeforeDockerAction(t *testing.T) {
+	counter := &databaseDockerActionCounter{}
+	fakeDocker, err := client.NewClientWithOpts(
+		client.WithHost("http://docker.invalid"),
+		client.WithVersion("1.47"),
+		client.WithHTTPClient(&http.Client{Transport: counter}),
+	)
+	require.NoError(t, err)
+
+	previousDocker := utils.Docker
+	previousConfig := utils.Config
+	previousDbID := utils.DbId
+	utils.Docker = fakeDocker
+	utils.Config = config.NewConfig(config.WithHostname("127.0.0.1"))
+	utils.DbId = "/var/run/docker.sock"
+	t.Cleanup(func() {
+		utils.Docker = previousDocker
+		utils.Config = previousConfig
+		utils.DbId = previousDbID
+		require.NoError(t, fakeDocker.Close())
+	})
+
+	err = StartDatabase(
+		context.Background(),
+		"",
+		afero.NewMemMapFs(),
+		io.Discard,
+	)
+	require.ErrorContains(t, err, "unsafe Docker container capability")
+	require.Zero(t, counter.volumeInspect)
+	require.Zero(t, counter.imageInspect)
+	require.Zero(t, counter.imagePull)
+	require.Zero(t, counter.networkCreate)
+	require.Zero(t, counter.volumeCreate)
+	require.Zero(t, counter.containerCreate)
+	require.Zero(t, counter.other)
+}
+
+func TestStartDatabaseFromBackupRejectsSymlinkedRuntimeSocketBeforeDockerAction(t *testing.T) {
+	socketNames := []string{
+		"docker.sock",
+		"containerd.sock",
+		"podman.sock",
+		"crio.sock",
+		"docker_engine",
+	}
+
+	for _, socketName := range socketNames {
+		socketName := socketName
+		t.Run(socketName, func(t *testing.T) {
+			counter := &databaseDockerActionCounter{}
+			fakeDocker, err := client.NewClientWithOpts(
+				client.WithHost("http://docker.invalid"),
+				client.WithVersion("1.47"),
+				client.WithHTTPClient(&http.Client{Transport: counter}),
+			)
+			require.NoError(t, err)
+
+			previousDocker := utils.Docker
+			previousConfig := utils.Config
+			previousDbID := utils.DbId
+			utils.Docker = fakeDocker
+			utils.Config = config.NewConfig(config.WithHostname("127.0.0.1"))
+			utils.DbId = "supabase_db_snaplist"
+			t.Cleanup(func() {
+				utils.Docker = previousDocker
+				utils.Config = previousConfig
+				utils.DbId = previousDbID
+				require.NoError(t, fakeDocker.Close())
+			})
+
+			tempDir := t.TempDir()
+			socketPath := filepath.Join(tempDir, socketName)
+			require.NoError(t, os.WriteFile(socketPath, []byte("protected"), 0o600))
+			safeLookingBackup := filepath.Join(tempDir, "backup.sql")
+			require.NoError(t, os.Symlink(socketPath, safeLookingBackup))
+
+			err = StartDatabase(
+				context.Background(),
+				safeLookingBackup,
+				afero.NewOsFs(),
+				io.Discard,
+			)
+			require.ErrorContains(t, err, "unsafe Docker container capability")
+			require.Zero(t, counter.volumeInspect)
+			require.Zero(t, counter.imageInspect)
+			require.Zero(t, counter.imagePull)
+			require.Zero(t, counter.networkCreate)
+			require.Zero(t, counter.volumeCreate)
+			require.Zero(t, counter.containerCreate)
+			require.Zero(t, counter.other)
+		})
+	}
+}
+
+func TestStartDatabaseFromBackupAllowsOrdinaryRegularFileBeforeDockerAction(t *testing.T) {
+	counter := &databaseDockerActionCounter{}
+	fakeDocker, err := client.NewClientWithOpts(
+		client.WithHost("http://docker.invalid"),
+		client.WithVersion("1.47"),
+		client.WithHTTPClient(&http.Client{Transport: counter}),
+	)
+	require.NoError(t, err)
+
+	previousDocker := utils.Docker
+	previousConfig := utils.Config
+	previousDbID := utils.DbId
+	utils.Docker = fakeDocker
+	utils.Config = config.NewConfig(config.WithHostname("127.0.0.1"))
+	utils.DbId = "supabase_db_snaplist"
+	t.Cleanup(func() {
+		utils.Docker = previousDocker
+		utils.Config = previousConfig
+		utils.DbId = previousDbID
+		require.NoError(t, fakeDocker.Close())
+	})
+
+	backupPath := filepath.Join(t.TempDir(), "backup.sql")
+	require.NoError(t, os.WriteFile(backupPath, []byte("select 1;"), 0o600))
+
+	err = StartDatabase(
+		context.Background(),
+		backupPath,
+		afero.NewOsFs(),
+		io.Discard,
+	)
+	require.Error(t, err)
+	require.NotContains(t, err.Error(), "unsafe Docker container capability")
+	require.Equal(t, 1, counter.volumeInspect)
+	require.Zero(t, counter.imageInspect)
+	require.Zero(t, counter.imagePull)
+	require.Zero(t, counter.networkCreate)
+	require.Zero(t, counter.volumeCreate)
+	require.Zero(t, counter.containerCreate)
+	require.Zero(t, counter.other)
+}
