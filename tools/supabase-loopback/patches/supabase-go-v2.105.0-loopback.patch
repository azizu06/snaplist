+}
+
+func TestPreparedRegularFileStageRejectsUntrustedParentBeforeCopy(t *testing.T) {
+	source := filepath.Join(t.TempDir(), "backup.sql")
+	require.NoError(t, os.WriteFile(source, []byte("sensitive backup bytes"), 0o600))
+	prepared, err := PrepareRegularFile(source)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, prepared.Close()) })
+
+	stagingParent := filepath.Join(t.TempDir(), "untrusted")
+	require.NoError(t, os.Mkdir(stagingParent, 0o777))
+	require.NoError(t, os.Chmod(stagingParent, 0o777))
+
+	staged, err := prepared.Stage(stagingParent)
+	if staged != nil {
+		t.Cleanup(func() { require.NoError(t, staged.Cleanup()) })
+	}
+	require.ErrorContains(t, err, "untrusted principal")
+	require.Nil(t, staged)
+
+	entries, readErr := os.ReadDir(stagingParent)
+	require.NoError(t, readErr)
+	require.Empty(t, entries, "backup bytes must not be staged beneath an untrusted parent")
+}
+
+func TestStagedRegularFileCleanupReportsRemovalFailure(t *testing.T) {
+	source := filepath.Join(t.TempDir(), "backup.sql")
+	require.NoError(t, os.WriteFile(source, []byte("select 1;"), 0o600))
+	prepared, err := PrepareRegularFile(source)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, prepared.Close()) })
+
+	staged, err := prepared.Stage(t.TempDir())
+	require.NoError(t, err)
+	removeAll := staged.removeAll
+	staged.removeAll = func(string) error { return errors.New("cleanup denied") }
+	require.ErrorContains(t, staged.Cleanup(), "cleanup denied")
+	require.NotEmpty(t, staged.Path)
+	staged.removeAll = removeAll
+	require.NoError(t, staged.Cleanup())
+}
diff --git a/apps/cli-go/internal/utils/isolation/hostsource_acl_darwin.go b/apps/cli-go/internal/utils/isolation/hostsource_acl_darwin.go
new file mode 100644
index 0000000..4234b27
--- /dev/null
+++ b/apps/cli-go/internal/utils/isolation/hostsource_acl_darwin.go
@@ -0,0 +1,108 @@
+//go:build darwin
+
+package isolation
+
+import (
+	"encoding/binary"
+	"fmt"
+	"os"
+	"runtime"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	darwinAttributeBitmapCount = 5
+	darwinAttributeHeaderSize  = 12
+	darwinAttributeBufferSize  = 8192
+	darwinFileSecurityMagic    = 0x012cc16d
+	darwinFileSecurityHeader   = 44
+	darwinACLMaxEntries        = 128
+	darwinACEBytes             = 24
+	darwinACEPermit            = 1
+	darwinACEKindMask          = 0xf
+	darwinACLWriteRights       = (1 << 2) |
+		(1 << 4) |
+		(1 << 5) |
+		(1 << 6) |
+		(1 << 8) |
+		(1 << 10) |
+		(1 << 12) |
+		(1 << 13) |
+		(1 << 21) |
+		(1 << 23) |
+		(1 << 25) |
+		(1 << 26)
+)
+
+// validatePlatformTrust rejects Darwin ACL entries that permit mutation. ACLs
+// supplement BSD mode permissions, so mode and owner checks alone cannot prove
+// cross-user safety. fgetattrlist inspects the already-open object and does not
+// depend on xattrs. Deny-only and read-only ACLs preserve the mode-based proof.
+func validatePlatformTrust(path string, expected os.FileInfo) error {
+	file, err := os.Open(path)
+	if err != nil {
+		return fmt.Errorf("open host bind source for ACL inspection at %s: %w", path, err)
+	}
+	defer file.Close()
+
+	opened, err := file.Stat()
+	if err != nil {
+		return fmt.Errorf("inspect host bind source for ACL inspection at %s: %w", path, err)
+	}
+	if !os.SameFile(expected, opened) {
+		return fmt.Errorf("host bind source changed during ACL inspection: %s", path)
+	}
+
+	attributes := unix.Attrlist{
+		Bitmapcount: darwinAttributeBitmapCount,
+		Commonattr:  unix.ATTR_CMN_EXTENDED_SECURITY,
+	}
+	buffer := make([]byte, darwinAttributeBufferSize)
+	_, _, errno := unix.Syscall6(
+		unix.SYS_FGETATTRLIST,
+		file.Fd(),
+		uintptr(unsafe.Pointer(&attributes)),
+		uintptr(unsafe.Pointer(&buffer[0])),
+		uintptr(len(buffer)),
+		0,
+		0,
+	)
+	runtime.KeepAlive(file)
+	if errno != 0 {
+		return fmt.Errorf("inspect host bind source ACL at %s: %w", path, errno)
+	}
+
+	total := int(binary.LittleEndian.Uint32(buffer[0:4]))
+	if total < darwinAttributeHeaderSize || total > len(buffer) {
+		return fmt.Errorf("inspect host bind source ACL at %s: malformed attribute response", path)
+	}
+	offset := int(int32(binary.LittleEndian.Uint32(buffer[4:8])))
+	length := int(binary.LittleEndian.Uint32(buffer[8:12]))
+	start := 4 + offset
+	if offset < 0 || start < darwinAttributeHeaderSize || start > total || length > total-start {
+		return fmt.Errorf("inspect host bind source ACL at %s: malformed ACL reference", path)
+	}
+	if length != 0 {
+		acl := buffer[start : start+length]
+		if len(acl) < darwinFileSecurityHeader ||
+			binary.LittleEndian.Uint32(acl[0:4]) != darwinFileSecurityMagic {
+			return fmt.Errorf("inspect host bind source ACL at %s: malformed file-security record", path)
+		}
+		entryCount := int(binary.LittleEndian.Uint32(acl[36:40]))
+		if entryCount > darwinACLMaxEntries ||
+			len(acl) != darwinFileSecurityHeader+entryCount*darwinACEBytes {
+			return fmt.Errorf("inspect host bind source ACL at %s: malformed ACL entries", path)
+		}
+		for index := 0; index < entryCount; index++ {
+			aceStart := darwinFileSecurityHeader + index*darwinACEBytes
+			flags := binary.LittleEndian.Uint32(acl[aceStart+16 : aceStart+20])
+			rights := binary.LittleEndian.Uint32(acl[aceStart+20 : aceStart+24])
+			if flags&darwinACEKindMask == darwinACEPermit && rights&darwinACLWriteRights != 0 {
+				return fmt.Errorf("host bind source has a write-capable Darwin ACL and cannot be proven cross-user safe: %s", path)
+			}
+		}
+	}
+	return nil
+}
