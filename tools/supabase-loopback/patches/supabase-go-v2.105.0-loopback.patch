+		config     container.Config
+		hostConfig container.HostConfig
+	}{
+		"docker socket bind": {
+			hostConfig: container.HostConfig{
+				Binds: []string{"/var/run/docker.sock:/var/run/docker.sock:ro"},
+			},
+		},
+		"rootless docker socket bind": {
+			hostConfig: container.HostConfig{
+				Binds: []string{"/home/user/.docker/run/docker.sock:/var/run/docker.sock:ro"},
+			},
+		},
+		"docker socket mount": {
+			hostConfig: container.HostConfig{
+				Mounts: []mount.Mount{{
+					Type:   mount.TypeBind,
+					Source: "/var/run/docker.sock",
+					Target: "/var/run/docker.sock",
+				}},
+			},
+		},
+		"docker host environment": {
+			config: container.Config{
+				Env: []string{"DOCKER_HOST=tcp://docker:2375"},
+			},
+		},
+		"privileged mode": {
+			hostConfig: container.HostConfig{Privileged: true},
+		},
+		"host network": {
+			hostConfig: container.HostConfig{
+				NetworkMode: container.NetworkMode("host"),
+			},
+		},
+		"device mapping": {
+			hostConfig: container.HostConfig{
+				Resources: container.Resources{
+					Devices: []container.DeviceMapping{{
+						PathOnHost:        "/dev/null",
+						PathInContainer:   "/dev/null",
+						CgroupPermissions: "r",
+					}},
+				},
+			},
+		},
+		"device request": {
+			hostConfig: container.HostConfig{
+				Resources: container.Resources{
+					DeviceRequests: []container.DeviceRequest{{Driver: "nvidia"}},
+				},
+			},
+		},
+		"device cgroup rule": {
+			hostConfig: container.HostConfig{
+				Resources: container.Resources{
+					DeviceCgroupRules: []string{"c 1:3 rwm"},
+				},
+			},
+		},
+		"publish all ports": {
+			hostConfig: container.HostConfig{PublishAllPorts: true},
+		},
+	}
+
+	for name, testCase := range tests {
