index 0000000..da09691
--- /dev/null
+++ b/apps/cli-go/internal/utils/isolation/hostsource_trust_unix.go
@@ -0,0 +1,51 @@
+//go:build darwin || linux
+
+package isolation
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+)
+
+func validateTrustedComponents(components []hostComponent) error {
+	effectiveUser := uint32(os.Geteuid())
+	for index, component := range components {
+		owner, err := componentOwner(component.info)
+		if err != nil {
+			return fmt.Errorf("inspect host bind source ownership at %s: %w", component.path, err)
+		}
+		if owner != 0 && owner != effectiveUser {
+			return fmt.Errorf("host bind source component is owned by an untrusted principal: %s", component.path)
+		}
+		if !component.info.IsDir() {
+			continue
+		}
+		untrustedWrite := component.info.Mode().Perm() & 0o022
+		if untrustedWrite == 0 {
+			continue
+		}
+		if index == len(components)-1 {
+			return fmt.Errorf("host bind directory is writable by an untrusted principal: %s", component.path)
+		}
+		if component.info.Mode()&os.ModeSticky == 0 {
+			return fmt.Errorf("host bind parent is replaceable by an untrusted principal: %s", component.path)
+		}
+		nextOwner, err := componentOwner(components[index+1].info)
+		if err != nil {
+			return fmt.Errorf("inspect host bind child ownership at %s: %w", components[index+1].path, err)
+		}
+		if nextOwner != 0 && nextOwner != effectiveUser {
+			return fmt.Errorf("host bind child in sticky parent is owned by an untrusted principal: %s", components[index+1].path)
+		}
+	}
+	return nil
+}
+
+func componentOwner(info os.FileInfo) (uint32, error) {
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return 0, fmt.Errorf("unsupported file ownership metadata")
+	}
+	return stat.Uid, nil
+}
