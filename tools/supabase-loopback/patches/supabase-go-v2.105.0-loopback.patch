+package isolation
+
+import (
+	"testing"
+
+	"github.com/docker/docker/api/types/container"
+	"github.com/docker/docker/api/types/mount"
+	"github.com/stretchr/testify/require"
+)
+
+func TestValidateContainerRejectsDockerHostCapabilities(t *testing.T) {
+	t.Parallel()
+
+	tests := map[string]struct {
+		config     container.Config
+		hostConfig container.HostConfig
+	}{
+		"docker socket bind": {
+			hostConfig: container.HostConfig{
+				Binds: []string{"/var/run/docker.sock:/var/run/docker.sock:ro"},
+			},
+		},
+		"rootless docker socket bind": {
+			hostConfig: container.HostConfig{
+				Binds: []string{"/home/user/.docker/run/docker.sock:/var/run/docker.sock:ro"},
+			},
+		},
+		"docker socket mount": {
+			hostConfig: container.HostConfig{
+				Mounts: []mount.Mount{{
+					Type:   mount.TypeBind,
+					Source: "/var/run/docker.sock",
+					Target: "/var/run/docker.sock",
+				}},
+			},
+		},
+		"docker host environment": {
+			config: container.Config{
+				Env: []string{"DOCKER_HOST=tcp://docker:2375"},
+			},
+		},
+		"privileged mode": {
+			hostConfig: container.HostConfig{Privileged: true},
+		},
+		"host network": {
+			hostConfig: container.HostConfig{
+				NetworkMode: container.NetworkMode("host"),
+			},
+		},
+		"device mapping": {
+			hostConfig: container.HostConfig{
+				Resources: container.Resources{
+					Devices: []container.DeviceMapping{{
+						PathOnHost:        "/dev/null",
+						PathInContainer:   "/dev/null",
+						CgroupPermissions: "r",
+					}},
+				},
+			},
+		},
+		"device request": {
+			hostConfig: container.HostConfig{
+				Resources: container.Resources{
+					DeviceRequests: []container.DeviceRequest{{Driver: "nvidia"}},
+				},
+			},
+		},
+		"device cgroup rule": {
+			hostConfig: container.HostConfig{
+				Resources: container.Resources{
+					DeviceCgroupRules: []string{"c 1:3 rwm"},
+				},
+			},
+		},
+		"publish all ports": {
+			hostConfig: container.HostConfig{PublishAllPorts: true},
+		},
+	}
+
+	for name, testCase := range tests {
+		testCase := testCase
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			require.Error(t, ValidateContainer(testCase.config, testCase.hostConfig))
+		})
+	}
+}
+
+func TestValidateContainerRejectsContainerRuntimeSockets(t *testing.T) {
+	t.Parallel()
+
+	socketPaths := map[string]string{
+		"docker":         "/var/run/DOCKER.SOCK",
+		"docker windows": `\\.\pipe\DOCKER_ENGINE`,
+		"containerd":     `\run\CONTAINERD\containerd.sock`,
+		"podman":         "/run/user/501/PODMAN/PODMAN.SOCK",
+		"crio":           "/var/run/CRIO/CRIO.SOCK",
+	}
+
+	for name, socketPath := range socketPaths {
+		name, socketPath := name, socketPath
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			cases := map[string]container.HostConfig{
+				"bind source": {
+					Binds: []string{socketPath + ":/safe/runtime:ro"},
+				},
+				"bind destination": {
+					Binds: []string{"/safe/runtime:" + socketPath + ":ro"},
+				},
+				"mount source": {
+					Mounts: []mount.Mount{{
+						Type:   mount.TypeBind,
+						Source: socketPath,
+						Target: "/safe/runtime",
+					}},
+				},
+				"mount destination": {
+					Mounts: []mount.Mount{{
+						Type:   mount.TypeBind,
+						Source: "/safe/runtime",
+						Target: socketPath,
+					}},
+				},
+			}
+
+			for form, hostConfig := range cases {
+				form, hostConfig := form, hostConfig
+				t.Run(form, func(t *testing.T) {
+					t.Parallel()
+					require.Error(t, ValidateContainer(container.Config{}, hostConfig))
+				})
+			}
+		})
+	}
+}
+
+func TestValidateContainerAllowsOrdinaryBridgeAndStorage(t *testing.T) {
+	t.Parallel()
+
+	config := container.Config{Env: []string{"APP_ENV=local"}}
+	hostConfig := container.HostConfig{
+		NetworkMode: container.NetworkMode("supabase_network_snaplist"),
+		Binds: []string{
+			"/tmp/snaplist:/work:ro",
+			"snaplist-db-data:/var/lib/postgresql/data",
+		},
+		Mounts: []mount.Mount{{
+			Type:   mount.TypeBind,
+			Source: "/tmp/snaplist-config",
+			Target: "/etc/snaplist",
+		}},
+	}
+
+	require.NoError(t, ValidateContainer(config, hostConfig))
+}
