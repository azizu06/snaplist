diff --git a/apps/cli-go/internal/utils/docker_isolation_test.go b/apps/cli-go/internal/utils/docker_isolation_test.go
new file mode 100644
index 0000000..26e15c7
--- /dev/null
+++ b/apps/cli-go/internal/utils/docker_isolation_test.go
@@ -0,0 +1,54 @@
+package utils
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/docker/docker/api/types/container"
+	"github.com/docker/docker/api/types/network"
+	"github.com/docker/docker/client"
+	"github.com/stretchr/testify/require"
+)
+
+type countingRoundTripper struct {
+	calls int
+}
+
+func (transport *countingRoundTripper) RoundTrip(*http.Request) (*http.Response, error) {
+	transport.calls++
+	return &http.Response{
+		StatusCode: http.StatusInternalServerError,
+		Body:       io.NopCloser(strings.NewReader("unexpected Docker action")),
+		Header:     make(http.Header),
+	}, nil
+}
+
+func TestDockerStartRejectsBeforeDockerAction(t *testing.T) {
+	transport := &countingRoundTripper{}
+	fakeDocker, err := client.NewClientWithOpts(
+		client.WithHost("http://docker.invalid"),
+		client.WithVersion("1.47"),
+		client.WithHTTPClient(&http.Client{Transport: transport}),
+	)
+	require.NoError(t, err)
+
+	previousDocker := Docker
+	Docker = fakeDocker
+	t.Cleanup(func() {
+		Docker = previousDocker
+		require.NoError(t, fakeDocker.Close())
+	})
+
+	_, err = DockerStart(
+		context.Background(),
+		container.Config{Image: "example.invalid/supabase/test:latest"},
+		container.HostConfig{Privileged: true},
+		network.NetworkingConfig{},
+		"unsafe-test",
+	)
+	require.ErrorContains(t, err, "unsafe Docker container capability")
+	require.Zero(t, transport.calls)
+}
diff --git a/apps/cli-go/internal/utils/isolation/hostconfig.go b/apps/cli-go/internal/utils/isolation/hostconfig.go
new file mode 100644
index 0000000..862ecd6
--- /dev/null
+++ b/apps/cli-go/internal/utils/isolation/hostconfig.go
@@ -0,0 +1,49 @@
+package isolation
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/docker/docker/api/types/container"
+)
+
+func ValidateContainer(config container.Config, hostConfig container.HostConfig) error {
+	for _, bind := range hostConfig.Binds {
+		if containsDockerSocket(bind) {
+			return fmt.Errorf("docker socket bind is forbidden")
+		}
+	}
+	for _, mounted := range hostConfig.Mounts {
+		if containsDockerSocket(mounted.Source) || containsDockerSocket(mounted.Target) {
+			return fmt.Errorf("docker socket mount is forbidden")
+		}
+	}
+	for _, environment := range config.Env {
+		name, _, _ := strings.Cut(environment, "=")
+		if strings.EqualFold(name, "DOCKER_HOST") {
+			return fmt.Errorf("container DOCKER_HOST is forbidden")
+		}
+	}
+	if hostConfig.Privileged {
+		return fmt.Errorf("privileged mode is forbidden")
+	}
+	if hostConfig.NetworkMode.IsHost() {
+		return fmt.Errorf("host network is forbidden")
+	}
+	if len(hostConfig.Resources.Devices) > 0 {
+		return fmt.Errorf("device mappings are forbidden")
+	}
+	if len(hostConfig.Resources.DeviceRequests) > 0 {
+		return fmt.Errorf("device requests are forbidden")
+	}
+	if hostConfig.PublishAllPorts {
+		return fmt.Errorf("PublishAllPorts is forbidden")
+	}
+	return nil
+}
+
+func containsDockerSocket(value string) bool {
+	normalized := strings.ToLower(strings.ReplaceAll(value, "\\", "/"))
+	return strings.Contains(normalized, "docker.sock") ||
+		strings.Contains(normalized, "//./pipe/docker_engine")
+}
