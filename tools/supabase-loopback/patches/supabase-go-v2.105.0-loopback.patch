+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/docker/docker/api/types/container"
+	"github.com/docker/docker/api/types/mount"
+	"github.com/docker/docker/api/types/network"
+	"github.com/docker/docker/client"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDockerStartRejectsHostBindWithDarwinACLBeforeDockerAction(t *testing.T) {
+	cases := map[string]func(*testing.T, string) string{
+		"source directory": func(t *testing.T, root string) string {
+			return root
+		},
+		"descendant directory": func(t *testing.T, root string) string {
+			descendant := filepath.Join(root, "nested", "acl-writable")
+			require.NoError(t, os.MkdirAll(descendant, 0o700))
+			return descendant
+		},
+	}
+	for caseName, aclPath := range cases {
+		caseName, aclPath := caseName, aclPath
+		t.Run(caseName, func(t *testing.T) {
+			root := filepath.Join(t.TempDir(), "mode-safe")
+			require.NoError(t, os.Mkdir(root, 0o700))
+			protectedPath := aclPath(t, root)
+			require.NoError(t, exec.Command(
+				"/bin/chmod",
+				"+a",
+				"everyone allow add_file,delete_child,writeattr,writeextattr",
+				protectedPath,
+			).Run())
+			info, err := os.Stat(protectedPath)
+			require.NoError(t, err)
+			require.Equal(t, os.FileMode(0o700), info.Mode().Perm())
+
+			forms := map[string]container.HostConfig{
+				"bind": {
+					Binds: []string{root + ":/safe/tree:ro"},
+				},
+				"mount": {
+					Mounts: []mount.Mount{{
+						Type:   mount.TypeBind,
+						Source: root,
+						Target: "/safe/tree",
+					}},
+				},
+			}
+			for form, hostConfig := range forms {
+				form, hostConfig := form, hostConfig
+				t.Run(form, func(t *testing.T) {
+					transport := &countingRoundTripper{}
+					fakeDocker, err := client.NewClientWithOpts(
+						client.WithHost("http://docker.invalid"),
+						client.WithVersion("1.47"),
+						client.WithHTTPClient(&http.Client{Transport: transport}),
+					)
+					require.NoError(t, err)
+
+					previousDocker := Docker
+					Docker = fakeDocker
+					t.Cleanup(func() {
+						Docker = previousDocker
+						require.NoError(t, fakeDocker.Close())
+					})
+
+					_, err = DockerStart(
+						context.Background(),
+						container.Config{Image: "example.invalid/supabase/test:latest"},
+						hostConfig,
+						network.NetworkingConfig{},
+						"darwin-acl-test",
+					)
+					require.ErrorContains(t, err, "unsafe Docker container capability")
+					require.Zero(t, transport.calls)
+				})
+			}
+		})
+	}
+}
