+func TestBindPublishedPortsNormalizesEveryPort(t *testing.T) {
+	t.Parallel()
+
+	bindings := nat.PortMap{
+		"5432/tcp": {{HostPort: "41234"}},
+		"6543/tcp": {{HostPort: "51234"}},
+	}
+
+	require.NoError(t, BindPublishedPorts(bindings))
+	require.Equal(t, []nat.PortBinding{
+		{HostIP: "127.0.0.1", HostPort: "41234"},
+		{HostIP: "::1", HostPort: "41234"},
+	}, bindings["5432/tcp"])
+	require.Equal(t, []nat.PortBinding{
+		{HostIP: "127.0.0.1", HostPort: "51234"},
+		{HostIP: "::1", HostPort: "51234"},
+	}, bindings["6543/tcp"])
+}
+
+func TestValidatePublishedPortsRejectsUnsafeBindings(t *testing.T) {
+	t.Parallel()
+
+	tests := map[string]nat.PortMap{
+		"empty host IP": {
+			"5432/tcp": {{HostIP: "", HostPort: "41234"}},
+		},
+		"wildcard IPv4": {
+			"5432/tcp": {{HostIP: "0.0.0.0", HostPort: "41234"}},
+		},
+		"wildcard IPv6": {
+			"5432/tcp": {{HostIP: "::", HostPort: "41234"}},
+		},
+		"missing IPv6 family": {
+			"5432/tcp": {{HostIP: "127.0.0.1", HostPort: "41234"}},
+		},
+		"empty host port": {
+			"5432/tcp": {
+				{HostIP: "127.0.0.1", HostPort: ""},
+				{HostIP: "::1", HostPort: ""},
+			},
+		},
+	}
+
+	for name, bindings := range tests {
+		bindings := bindings
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			require.Error(t, ValidatePublishedPorts(bindings))
+		})
+	}
+}
