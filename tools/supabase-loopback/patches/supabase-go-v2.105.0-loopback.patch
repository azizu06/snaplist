diff --git a/apps/cli-go/internal/utils/isolation/hostconfig.go b/apps/cli-go/internal/utils/isolation/hostconfig.go
new file mode 100644
index 0000000..da16bd2
--- /dev/null
+++ b/apps/cli-go/internal/utils/isolation/hostconfig.go
@@ -0,0 +1,408 @@
+package isolation
+
+import (
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/docker/docker/api/types/container"
+	"github.com/docker/docker/api/types/mount"
+)
+
+func ValidateContainer(config container.Config, hostConfig container.HostConfig) error {
+	prepared, err := PrepareContainer(config, hostConfig)
+	if err != nil {
+		return err
+	}
+	return prepared.Close()
+}
+
+type PreparedContainer struct {
+	HostConfig container.HostConfig
+	sources    []*hostSourceGuard
+}
+
+func PrepareContainer(config container.Config, hostConfig container.HostConfig) (*PreparedContainer, error) {
+	hostConfig.Binds = append([]string(nil), hostConfig.Binds...)
+	hostConfig.Mounts = append([]mount.Mount(nil), hostConfig.Mounts...)
+	prepared := &PreparedContainer{HostConfig: hostConfig}
+	fail := func(err error) (*PreparedContainer, error) {
+		_ = prepared.Close()
+		return nil, err
+	}
+	for index, bind := range hostConfig.Binds {
+		source, destination, mode, hostPath, err := parseBind(bind)
+		if err != nil {
+			return fail(fmt.Errorf("invalid bind specification: %w", err))
+		}
+		if containsContainerRuntimeSocket(destination) {
+			return fail(fmt.Errorf("container runtime socket bind is forbidden"))
+		}
+		if containsContainerRuntimeSocket(source) {
+			return fail(fmt.Errorf("container runtime socket bind is forbidden"))
+		}
+		if hostPath {
+			guard, err := openHostSource(source)
+			if err != nil {
+				return fail(err)
+			}
+			prepared.sources = append(prepared.sources, guard)
+			hostConfig.Binds[index] = guard.canonical + ":" + destination
+			if mode != "" {
+				hostConfig.Binds[index] += ":" + mode
+			}
+		} else {
+			// Named volumes do not traverse a caller-selected host path.
+		}
+	}
+	for index, mounted := range hostConfig.Mounts {
+		if containsContainerRuntimeSocket(mounted.Target) {
+			return fail(fmt.Errorf("container runtime socket mount is forbidden"))
+		}
+		switch mounted.Type {
+		case mount.TypeBind:
+			guard, err := openHostSource(mounted.Source)
+			if err != nil {
+				return fail(err)
+			}
+			prepared.sources = append(prepared.sources, guard)
+			hostConfig.Mounts[index].Source = guard.canonical
+		case mount.TypeVolume, mount.TypeTmpfs:
+			// Named volumes and tmpfs mounts have no caller-selected host path.
+		case mount.TypeNamedPipe:
+			return fail(fmt.Errorf("container runtime named-pipe mount is forbidden"))
+		default:
+			return fail(fmt.Errorf("unsupported mount type %q", mounted.Type))
+		}
+	}
+	for _, environment := range config.Env {
+		name, _, _ := strings.Cut(environment, "=")
+		if strings.EqualFold(name, "DOCKER_HOST") {
+			return fail(fmt.Errorf("container DOCKER_HOST is forbidden"))
+		}
+	}
+	if hostConfig.Privileged {
+		return fail(fmt.Errorf("privileged mode is forbidden"))
+	}
+	if hostConfig.NetworkMode.IsHost() {
+		return fail(fmt.Errorf("host network is forbidden"))
+	}
+	if len(hostConfig.Resources.Devices) > 0 {
+		return fail(fmt.Errorf("device mappings are forbidden"))
+	}
+	if len(hostConfig.Resources.DeviceRequests) > 0 {
+		return fail(fmt.Errorf("device requests are forbidden"))
+	}
+	if len(hostConfig.Resources.DeviceCgroupRules) > 0 {
+		return fail(fmt.Errorf("device cgroup rules are forbidden"))
+	}
+	if hostConfig.PublishAllPorts {
+		return fail(fmt.Errorf("PublishAllPorts is forbidden"))
+	}
+	prepared.HostConfig = hostConfig
+	return prepared, nil
+}
+
+func (prepared *PreparedContainer) Revalidate() error {
+	for _, source := range prepared.sources {
+		if err := source.Revalidate(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (prepared *PreparedContainer) Close() error {
+	var first error
+	for _, source := range prepared.sources {
+		if err := source.Close(); err != nil && first == nil {
+			first = err
+		}
+	}
+	prepared.sources = nil
+	return first
+}
+
+func parseBind(bind string) (source, destination, mode string, hostPath bool, err error) {
+	if containsWindowsNamedPipe(bind) {
+		return "", "", "", false, fmt.Errorf("container runtime named-pipe bind is forbidden")
+	}
+	parts := strings.SplitN(bind, ":", 4)
+	if len(parts) < 2 || len(parts) > 3 || parts[0] == "" || parts[1] == "" {
+		return "", "", "", false, fmt.Errorf("expected source:destination[:mode]")
+	}
+	source, destination = parts[0], parts[1]
+	if len(parts) == 3 {
+		mode = parts[2]
+	}
+	return source, destination, mode, filepath.IsAbs(source), nil
+}
+
+type PreparedRegularFile struct {
+	source *hostSourceGuard
+}
+
+func PrepareRegularFile(source string) (*PreparedRegularFile, error) {
+	guard, err := openHostSource(source)
+	if err != nil {
+		return nil, err
+	}
+	if !guard.info.Mode().IsRegular() {
+		_ = guard.Close()
+		return nil, fmt.Errorf("host bind source must be a regular file")
+	}
+	return &PreparedRegularFile{source: guard}, nil
+}
+
+func (prepared *PreparedRegularFile) Stage(stagingParent string) (*StagedFile, error) {
+	if err := prepared.source.Revalidate(); err != nil {
+		return nil, err
+	}
+	if _, err := prepared.source.file.Seek(0, io.SeekStart); err != nil {
+		return nil, fmt.Errorf("rewind host bind source: %w", err)
+	}
+	absoluteParent, err := filepath.Abs(stagingParent)
+	if err != nil {
+		return nil, fmt.Errorf("resolve host bind staging parent: %w", err)
+	}
+	if err := os.MkdirAll(absoluteParent, 0o700); err != nil {
+		return nil, fmt.Errorf("create host bind staging parent: %w", err)
+	}
+	canonicalParent, err := filepath.EvalSymlinks(absoluteParent)
+	if err != nil {
+		return nil, fmt.Errorf("canonicalize host bind staging parent: %w", err)
+	}
+	parentInfo, err := validateCanonicalComponents(canonicalParent)
+	if err != nil {
+		return nil, fmt.Errorf("validate host bind staging parent: %w", err)
+	}
+	if !parentInfo.IsDir() {
+		return nil, fmt.Errorf("host bind staging parent must be a directory")
+	}
+	stagingDir, err := os.MkdirTemp(canonicalParent, "isolated-bind-")
+	if err != nil {
+		return nil, fmt.Errorf("create host bind staging directory: %w", err)
+	}
+	staged := &StagedFile{
+		directory: stagingDir,
+		removeAll: os.RemoveAll,
+	}
+	cleanupOnError := func(cause error) (*StagedFile, error) {
+		if cleanupErr := staged.Cleanup(); cleanupErr != nil {
+			return nil, fmt.Errorf("%w; additionally %v", cause, cleanupErr)
+		}
+		return nil, cause
+	}
+	if err := os.Chmod(stagingDir, 0o700); err != nil {
+		return cleanupOnError(fmt.Errorf("secure host bind staging directory: %w", err))
+	}
+	staged.Path = filepath.Join(stagingDir, "source")
+	output, err := os.OpenFile(staged.Path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return cleanupOnError(fmt.Errorf("create staged host bind source: %w", err))
+	}
+	if _, err := io.Copy(output, prepared.source.file); err != nil {
+		_ = output.Close()
+		return cleanupOnError(fmt.Errorf("stage host bind source: %w", err))
+	}
+	if err := output.Close(); err != nil {
+		return cleanupOnError(fmt.Errorf("close staged host bind source: %w", err))
+	}
+	return staged, nil
+}
+
+func (prepared *PreparedRegularFile) Close() error {
+	if prepared == nil || prepared.source == nil {
+		return nil
+	}
+	err := prepared.source.Close()
+	prepared.source = nil
+	return err
+}
+
+type StagedFile struct {
+	Path      string
+	directory string
+	removeAll func(string) error
+}
+
+func (staged *StagedFile) Cleanup() error {
+	if staged == nil || staged.directory == "" {
+		return nil
+	}
+	directory := staged.directory
+	if err := staged.removeAll(directory); err != nil {
+		return fmt.Errorf("remove staged host bind source %s: %w", directory, err)
+	}
+	staged.directory = ""
+	staged.Path = ""
+	return nil
+}
+
+type hostSourceGuard struct {
+	canonical string
+	file      *os.File
+	info      os.FileInfo
+}
+
+func openHostSource(source string) (*hostSourceGuard, error) {
+	absolute, err := filepath.Abs(source)
+	if err != nil {
+		return nil, fmt.Errorf("resolve host bind source: %w", err)
+	}
+	canonical, err := filepath.EvalSymlinks(absolute)
+	if err != nil {
+		return nil, fmt.Errorf("resolve host bind source: %w", err)
+	}
+	canonical = filepath.Clean(canonical)
+	if containsContainerRuntimeSocket(canonical) {
+		return nil, fmt.Errorf("container runtime socket bind is forbidden")
+	}
+	info, err := validateCanonicalComponents(canonical)
+	if err != nil {
+		return nil, err
+	}
+	file, err := os.Open(canonical)
+	if err != nil {
+		return nil, fmt.Errorf("open host bind source: %w", err)
+	}
+	openedInfo, err := file.Stat()
+	if err != nil {
+		_ = file.Close()
+		return nil, fmt.Errorf("inspect opened host bind source: %w", err)
+	}
+	if !os.SameFile(info, openedInfo) {
+		_ = file.Close()
+		return nil, fmt.Errorf("host bind source changed while opening")
+	}
+	if openedInfo.IsDir() {
+		if err := validateDirectoryTree(canonical); err != nil {
+			_ = file.Close()
+			return nil, err
+		}
+	}
+	return &hostSourceGuard{canonical: canonical, file: file, info: openedInfo}, nil
+}
+
+func (source *hostSourceGuard) Revalidate() error {
+	canonical, err := filepath.EvalSymlinks(source.canonical)
+	if err != nil {
+		return fmt.Errorf("revalidate host bind source: %w", err)
+	}
+	if filepath.Clean(canonical) != source.canonical || containsContainerRuntimeSocket(canonical) {
+		return fmt.Errorf("host bind source changed after validation")
+	}
+	current, err := validateCanonicalComponents(source.canonical)
+	if err != nil {
+		return err
+	}
+	held, err := source.file.Stat()
+	if err != nil {
+		return fmt.Errorf("inspect held host bind source: %w", err)
+	}
+	if !os.SameFile(source.info, current) || !os.SameFile(source.info, held) {
+		return fmt.Errorf("host bind source identity changed after validation")
+	}
+	if held.IsDir() {
+		if err := validateDirectoryTree(source.canonical); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (source *hostSourceGuard) Close() error {
+	if source.file == nil {
+		return nil
+	}
+	err := source.file.Close()
+	source.file = nil
+	return err
+}
+
+func validateCanonicalComponents(canonical string) (os.FileInfo, error) {
+	volume := filepath.VolumeName(canonical)
+	current := volume + string(os.PathSeparator)
+	relative := strings.TrimPrefix(canonical, current)
+	components := strings.Split(relative, string(os.PathSeparator))
+	inspected := make([]hostComponent, 0, len(components))
+	var info os.FileInfo
+	for index, component := range components {
+		if component == "" {
+			continue
+		}
+		current = filepath.Join(current, component)
+		var err error
+		info, err = os.Lstat(current)
+		if err != nil {
+			return nil, fmt.Errorf("inspect host bind source component: %w", err)
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return nil, fmt.Errorf("host bind source contains a symlink component")
+		}
+		if index < len(components)-1 && !info.IsDir() {
+			return nil, fmt.Errorf("host bind source parent must be a directory")
+		}
+		inspected = append(inspected, hostComponent{path: current, info: info})
+	}
+	if info == nil || !isSupportedHostSourceMode(info.Mode()) {
+		return nil, fmt.Errorf("host bind source must be a regular file or directory")
+	}
+	if err := validateTrustedComponents(inspected); err != nil {
+		return nil, err
+	}
+	return info, nil
+}
+
+type hostComponent struct {
+	path string
+	info os.FileInfo
+}
+
+func validateDirectoryTree(root string) error {
+	return filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return fmt.Errorf("inspect host bind directory tree: %w", walkErr)
+		}
+		if entry.Type()&os.ModeSymlink != 0 {
+			return fmt.Errorf("host bind directory contains a symlink: %s", path)
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return fmt.Errorf("inspect host bind directory entry: %w", err)
+		}
+		if containsContainerRuntimeSocket(filepath.Base(path)) {
+			return fmt.Errorf("host bind directory contains a container runtime endpoint: %s", path)
+		}
+		if !isSupportedHostSourceMode(info.Mode()) {
+			return fmt.Errorf("host bind directory contains a special file: %s", path)
+		}
+		if err := validateTrustedTreeEntry(path, info); err != nil {
+			return err
+		}
+		return nil
+	})
+}
+
+func isSupportedHostSourceMode(mode os.FileMode) bool {
+	return mode.IsRegular() || mode.IsDir()
+}
+
+func containsContainerRuntimeSocket(value string) bool {
+	normalized := strings.ToLower(strings.ReplaceAll(value, "\\", "/"))
+	return strings.Contains(normalized, "docker.sock") ||
+		strings.Contains(normalized, "containerd.sock") ||
+		strings.Contains(normalized, "podman.sock") ||
+		strings.Contains(normalized, "crio.sock") ||
+		strings.Contains(normalized, "//./pipe/docker_engine") ||
+		normalized == "docker_engine" ||
+		strings.HasSuffix(normalized, "/docker_engine")
+}
+
+func containsWindowsNamedPipe(value string) bool {
+	normalized := strings.ToLower(strings.ReplaceAll(value, "\\", "/"))
+	return strings.Contains(normalized, "//./pipe/")
+}
