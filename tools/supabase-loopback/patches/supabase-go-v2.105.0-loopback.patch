+type safeCachedImageRoundTripper struct {
+	imageInspect    int
+	imagePull       int
+	containerCreate int
+	containerStart  int
+	other           int
+}
+
+func (transport *safeCachedImageRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	status := http.StatusInternalServerError
+	body := "unexpected Docker action"
+	switch {
+	case request.Method == http.MethodGet && strings.Contains(request.URL.Path, "/images/") && strings.HasSuffix(request.URL.Path, "/json"):
+		transport.imageInspect++
+		status = http.StatusOK
+		body = "{}"
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/images/create"):
+		transport.imagePull++
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/containers/create"):
+		transport.containerCreate++
+		status = http.StatusCreated
+		body = `{"Id":"safe-container","Warnings":[]}`
+	case request.Method == http.MethodPost && strings.HasSuffix(request.URL.Path, "/start"):
+		transport.containerStart++
+		status = http.StatusNoContent
+		body = ""
+	default:
+		transport.other++
+	}
+	return &http.Response{
+		StatusCode: status,
+		Body:       io.NopCloser(strings.NewReader(body)),
+		Header:     make(http.Header),
+	}, nil
+}
+
+func TestDockerStartUsesCachedImageAndStartsSafeContainer(t *testing.T) {
+	transport := &safeCachedImageRoundTripper{}
+	fakeDocker, err := client.NewClientWithOpts(
+		client.WithHost("http://docker.invalid"),
+		client.WithVersion("1.47"),
+		client.WithHTTPClient(&http.Client{Transport: transport}),
+	)
+	require.NoError(t, err)
+
+	previousDocker := Docker
+	Docker = fakeDocker
+	t.Cleanup(func() {
+		Docker = previousDocker
+		require.NoError(t, fakeDocker.Close())
+	})
+
+	containerID, err := DockerStart(
+		context.Background(),
+		container.Config{Image: "example.invalid/supabase/test:latest"},
+		container.HostConfig{NetworkMode: container.NetworkMode("bridge")},
+		network.NetworkingConfig{},
+		"safe-cached-image-test",
+	)
+	require.NoError(t, err)
+	require.Equal(t, "safe-container", containerID)
+	require.Equal(t, 1, transport.imageInspect)
+	require.Zero(t, transport.imagePull)
+	require.Equal(t, 1, transport.containerCreate)
+	require.Equal(t, 1, transport.containerStart)
+	require.Zero(t, transport.other)
+}
+
+func TestDockerStartRejectsBeforeDockerAction(t *testing.T) {
