+func TestValidateContainerAllowsNonWriteDarwinACL(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "deny-only-acl")
+	require.NoError(t, os.Mkdir(root, 0o700))
+	require.NoError(t, exec.Command(
+		"/bin/chmod",
+		"+a",
+		"everyone deny delete",
+		root,
+	).Run())
+	t.Cleanup(func() {
+		require.NoError(t, exec.Command("/bin/chmod", "-N", root).Run())
+	})
+
+	require.NoError(t, ValidateContainer(
+		container.Config{},
+		container.HostConfig{Binds: []string{root + ":/safe/tree:ro"}},
+	))
+}
+
+func TestPreparedRegularFileStageRejectsACLWritableParentBeforeCopy(t *testing.T) {
+	source := filepath.Join(t.TempDir(), "backup.sql")
+	require.NoError(t, os.WriteFile(source, []byte("sensitive backup bytes"), 0o600))
+	prepared, err := PrepareRegularFile(source)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, prepared.Close()) })
+
+	stagingParent := filepath.Join(t.TempDir(), "mode-safe-but-acl-writable")
+	require.NoError(t, os.Mkdir(stagingParent, 0o700))
+	require.NoError(t, exec.Command(
+		"/bin/chmod",
+		"+a",
+		"everyone allow add_file,delete_child,writeattr,writeextattr",
+		stagingParent,
+	).Run())
+
+	staged, err := prepared.Stage(stagingParent)
+	if staged != nil {
+		t.Cleanup(func() { require.NoError(t, staged.Cleanup()) })
+	}
+	require.ErrorContains(t, err, "write-capable Darwin ACL")
+	require.Nil(t, staged)
+
+	entries, readErr := os.ReadDir(stagingParent)
+	require.NoError(t, readErr)
+	require.Empty(t, entries, "backup bytes must not be staged beneath an ACL-writable parent")
+}
