@@ -0,0 +1,96 @@
+package loopback
+
+import (
+	"fmt"
+	"sort"
+
+	"github.com/docker/go-connections/nat"
+)
+
+const (
+	ipv4 = "127.0.0.1"
+	ipv6 = "::1"
+)
+
+func BindPublishedPorts(portBindings nat.PortMap) error {
+	for port, bindings := range portBindings {
+		if len(bindings) == 0 {
+			return fmt.Errorf("published port %s has no host bindings", port)
+		}
+
+		hostPorts := make(map[string]struct{}, len(bindings))
+		hasOmittedHostIP := false
+		hasExplicitHostIP := false
+		for _, binding := range bindings {
+			if binding.HostPort == "" {
+				return fmt.Errorf("published port %s has an empty host port", port)
+			}
+			hostPorts[binding.HostPort] = struct{}{}
+			if binding.HostIP == "" {
+				hasOmittedHostIP = true
+			} else {
+				hasExplicitHostIP = true
+			}
+		}
+		if hasOmittedHostIP && hasExplicitHostIP {
+			return fmt.Errorf("published port %s mixes omitted and explicit host IPs", port)
+		}
+		if hasExplicitHostIP {
+			if err := ValidatePublishedPorts(nat.PortMap{port: bindings}); err != nil {
+				return err
+			}
+			continue
+		}
+
+		sortedHostPorts := make([]string, 0, len(hostPorts))
+		for hostPort := range hostPorts {
+			sortedHostPorts = append(sortedHostPorts, hostPort)
+		}
+		sort.Strings(sortedHostPorts)
+
+		normalized := make([]nat.PortBinding, 0, len(sortedHostPorts)*2)
+		for _, hostPort := range sortedHostPorts {
+			normalized = append(normalized,
+				nat.PortBinding{HostIP: ipv4, HostPort: hostPort},
+				nat.PortBinding{HostIP: ipv6, HostPort: hostPort},
+			)
+		}
+		portBindings[port] = normalized
+	}
+	return ValidatePublishedPorts(portBindings)
+}
+
+func ValidatePublishedPorts(portBindings nat.PortMap) error {
+	for port, bindings := range portBindings {
+		if len(bindings) == 0 {
+			return fmt.Errorf("published port %s has no host bindings", port)
+		}
+
+		hostIPsByPort := map[string]map[string]int{}
+		for _, binding := range bindings {
+			if binding.HostPort == "" {
+				return fmt.Errorf("published port %s has an empty host port", port)
+			}
+			if binding.HostIP != ipv4 && binding.HostIP != ipv6 {
+				return fmt.Errorf("published port %s has unsafe host IP %q", port, binding.HostIP)
+			}
+			if hostIPsByPort[binding.HostPort] == nil {
+				hostIPsByPort[binding.HostPort] = map[string]int{}
+			}
+			hostIPsByPort[binding.HostPort][binding.HostIP]++
+		}
+
+		for hostPort, hostIPs := range hostIPsByPort {
+			if hostIPs[ipv4] != 1 || hostIPs[ipv6] != 1 || len(hostIPs) != 2 {
+				return fmt.Errorf(
+					"published port %s:%s must bind exactly once to %s and %s",
+					port,
+					hostPort,
+					ipv4,
+					ipv6,
+				)
+			}
+		}
+	}
+	return nil
+}
