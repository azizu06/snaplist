+func TestStartDatabaseRejectsUnsafeDerivedConfigBeforeDockerAction(t *testing.T) {
+	counter := &databaseDockerActionCounter{}
+	fakeDocker, err := client.NewClientWithOpts(
+		client.WithHost("http://docker.invalid"),
+		client.WithVersion("1.47"),
+		client.WithHTTPClient(&http.Client{Transport: counter}),
+	)
+	require.NoError(t, err)
+
+	previousDocker := utils.Docker
+	previousConfig := utils.Config
+	previousDbID := utils.DbId
+	utils.Docker = fakeDocker
+	utils.Config = config.NewConfig(config.WithHostname("127.0.0.1"))
+	utils.DbId = "/var/run/docker.sock"
+	t.Cleanup(func() {
+		utils.Docker = previousDocker
+		utils.Config = previousConfig
+		utils.DbId = previousDbID
+		require.NoError(t, fakeDocker.Close())
+	})
+
+	err = StartDatabase(
+		context.Background(),
+		"",
+		afero.NewMemMapFs(),
+		io.Discard,
+	)
+	require.ErrorContains(t, err, "unsafe Docker container capability")
+	require.Zero(t, counter.volumeInspect)
+	require.Zero(t, counter.imageInspect)
+	require.Zero(t, counter.imagePull)
+	require.Zero(t, counter.networkCreate)
+	require.Zero(t, counter.volumeCreate)
+	require.Zero(t, counter.containerCreate)
+	require.Zero(t, counter.other)
+}
