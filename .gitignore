# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# pnpm is the only package manager (packageManager: pnpm@10.28.1);
# an npm lockfile is an accidental artifact — never track it
package-lock.json

# next.js / build
/.next/
/out/
/build
/dist

# env & secrets
.env
.env*.local
.env.local
.env.development.local
.env.production.local

# supabase local
/supabase/.branches
/supabase/.temp
/tools/supabase-loopback/.cache/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
next-env.d.ts

# editor
.idea/
.vscode/*
!.vscode/extensions.json

# graphify (local knowledge-graph index; regenerate with `graphify update .`)
/graphify-out

# clerk configuration (can include secrets)
/.clerk/

# local design iteration screenshots
.design-iterations/

# Claude Code agent worktrees (local only — never track)
.claude/worktrees/

# temporary asset-intake (raw archive, not shipped)
asset-intake/

# local render/review scratch
.review-shots/
.verify-shots/
/output/playwright/

# Impeccable design skill + hook (vendored per-developer; reinstall with
# `npx impeccable skills install`). Kept local so it doesn't bloat the repo.
.claude/skills/impeccable/
.claude/settings.local.json
.impeccable/
# Impeccable project context (per-developer design register; not shipped)
PRODUCT.md
DESIGN.md

# Xcode local state and generated fidelity output
ios/**/xcuserdata/
ios/DerivedData/
ios/Artifacts/
*.xcuserstate

# Agent-to-agent coordination notes. These are working artifacts of whoever is
# implementing an issue, not repository content, and must not reach main.
.hub-relay/
