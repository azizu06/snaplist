.github
node_modules
.next
out
build
dist
.env
.env*.local
*.pem
.vercel
supabase/.branches
supabase/.temp
docs
*.md
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
Dockerfile
.dockerignore
