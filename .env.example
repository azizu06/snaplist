# Copy to .env.local and fill in. Never commit real secrets (see .gitignore).

# --- LLM provider registry (at least one provider key required) ---
# Provider is a config flip (issue #55). REQUIRED in every deployed environment
# (#501): leaving it unset outside local development is a startup failure, not a
# default. Google's unpaid tier permits use of submitted content to improve Google
# products and permits human review of it, and seller photos resolve through this
# registry, so the free tier must never be reached by fallthrough. It may be omitted
# only under `next dev`, vitest, or a bare script, where it means Gemini (free tier,
# protects the OpenAI budget). `next start` and `docker run` set NODE_ENV=production
# even locally, so those need it set like any deploy.
# LLM_PROVIDER=gemini        # gemini|google | openai — required outside local dev
OPENAI_API_KEY=              # required for the showcase / when LLM_PROVIDER=openai
GOOGLE_GENERATIVE_AI_API_KEY=  # required for dev / when LLM_PROVIDER=gemini (or GEMINI_API_KEY)
# GEMINI_API_KEY=            # accepted as an alias for GOOGLE_GENERATIVE_AI_API_KEY
#
# Choosing Gemini is not enough to send it SELLER PHOTOS (#501). Outside local
# development the vision role — the only role that sends the seller's own photo
# bytes — refuses Google unless you attest the project is billing-enabled, which
# is what puts it under Google's Paid Services terms. Unset means "not attested",
# which is the safe answer; only `true` and `false` are accepted. This is a claim
# about billing in the Google console, not a switch: setting it falsely buys the
# exposure it exists to prevent. The project in use is free tier (ADR-0002).
# GEMINI_BILLING_ENABLED=true
# Per-role model id overrides (optional; must match the active provider):
# VISION_MODEL=  LISTING_MODEL=  EXPORT_PACK_MODEL=  PRICING_MODEL=  EVAL_JUDGE_MODEL=  CLARIFY_MODEL=

# --- Web search (pricing research agent; at least one recommended) ---
TAVILY_API_KEY=
EXA_API_KEY=

# --- Observability: Sentry error tracking (issue #62; OPTIONAL, DSN-gated) ---
# With no DSN, Sentry is inert and structured logging still runs. Set the DSN in
# the deploy env to activate grouped, alerted error capture.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production   # defaults to NODE_ENV

# --- Abuse & cost protection (issue #58; OPTIONAL) ---
# Upstash Redis powers rate limiting + the daily spend guardrail. With both unset,
# an in-memory fallback keeps dev/offline working (per-instance, not shared).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Limit overrides (sensible defaults in src/lib/abuse/config.ts):
# RATE_LIMIT_FREE_PER_MINUTE=20   # metered AI/API requests per minute (free tier)
# QUOTA_FREE_ITEMS_PER_DAY=15     # items processed per day (free tier)
# OPENAI_DAILY_CALL_BUDGET=1000   # global daily pipeline-run budget (alert only)

# --- Billing: freemium subscriptions via direct Stripe (issue #64; OPTIONAL, TEST MODE) ---
# All Stripe TEST keys. With these unset the /api/billing routes return 503 and
# getEntitlement reports everyone `free` (the app + offline tests run without them).
# Going live later is a key swap. Redirect URLs derive from the request origin.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` or the dashboard webhook
# STRIPE_PRICE_PRO=price_...        # the Pro plan's price id (single paid tier)

# --- Native StoreKit lifecycle through RevenueCat (issue #173; OPTIONAL) ---
# Leave all values unset for the truthful offline/unconfigured state. The app,
# entitlement bridge, and deterministic fixtures require no provider access.
# Populate only after the operator runbook verifies canonical App Store and
# RevenueCat identifiers. Never commit real webhook credentials.
# REVENUECAT_WEBHOOK_SIGNING_SECRET=
# REVENUECAT_WEBHOOK_AUTHORIZATION=
# REVENUECAT_SECRET_API_KEY=       # server-only; required in deployed envs for account erasure
# REVENUECAT_PROJECT_ID=            # required in deployed envs for account erasure
# REVENUECAT_APP_ID=
# REVENUECAT_ENTITLEMENT_ID=
# REVENUECAT_MONTHLY_PRODUCT_ID=    # exact canonical monthly App Store product id
# REVENUECAT_IOS_PUBLIC_SDK_KEY=     # public SDK key; delivered after Clerk auth
# REVENUECAT_OFFERING_ID=            # optional; current offering is used when absent
# SNAPLIST_PRO_MONTHLY_AI_ITEM_ALLOWANCE=  # final count remains owned by issue #189

# --- Native App Attest verification (issue #331; DEFAULT-UNAVAILABLE) ---
# APP_ATTEST_APP_ID is the registered App ID prefix plus the exact native bundle ID.
# Keep environment explicit: production and development keys are never interchangeable.
# Successful fresh assertions issue/refresh a 30-minute opaque GuestBearer. The
# imported ES256 key below signs a fresh <=60-second internal JWT for each protected
# Supabase operation. Use distinct production/preview keys; never expose the PEM.
# Deployed envs require the real Apple Team ID and registered bundle ID. Do not
# copy placeholder values such as TEAMID1234.dev.snaplist.ios into a deployment.
# APP_ATTEST_APP_ID=<APPLE_TEAM_ID>.<registered.native.bundle.id>
# APP_ATTEST_ENVIRONMENT=production
# APP_ATTEST_CHALLENGE_TTL_SECONDS=300  # bounded to 60...600 seconds
# The versioned guest-claim handoff route also requires the App ID components,
# Apple's App Attest root CA, and an independent server-only HMAC key. Keep the
# PEM and signing key out of source control; the values below are placeholders.
# APP_ATTEST_TEAM_ID=<real-10-character-Apple-Team-ID>
# APP_ATTEST_BUNDLE_ID=<registered.native.bundle.id>
# APP_ATTEST_ROOT_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# APP_ATTEST_HANDOFF_TTL_SECONDS=300  # bounded to 60...600 seconds
# APP_ATTEST_HANDOFF_SIGNING_KEY=base64url-encoded-32-byte-random-value
# SUPABASE_GUEST_JWT_KEY_ID=guest-es256-production-2026-07
# SUPABASE_GUEST_JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# --- Included first AI offer device fence (issue #524; DEFAULT-UNAVAILABLE) ---
# DeviceCheck credentials from the Apple developer portal. The DeviceCheck
# environment follows APP_ATTEST_ENVIRONMENT above: a development key reads the
# development device bit, so mixing them silently fences the wrong device state.
# Missing or unreadable credentials deny the included offer; they never grant one.
# APPLE_TEAM_ID=<real-10-character-Apple-Team-ID>
# APPLE_DEVICECHECK_KEY_ID=DCKEY12345
# APPLE_DEVICECHECK_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# The redemption queue advances through /api/internal/included-offer-worker,
# authenticated by the same CRON_SECRET as the durable pipeline worker below.

# --- Experimental listing-example retrieval (ADR-0010; DEFAULT-OFF) ---
# Leave disabled until issue #263's paired benchmark proves seller value. This
# server-only adapter may influence listing style/structure, never facts or pricing,
# and any empty/error/timeout result falls through to ordinary listing generation.
# LISTING_EXAMPLE_RETRIEVAL_ENABLED=false
# LISTING_EXAMPLE_RETRIEVAL_TIMEOUT_MS=2000  # positive milliseconds; hard-capped at 5000

# --- eBay sold-listings scraper (pricing tier "ebay-sold"; no key, no auth) ---
# OPTIONAL Caffein Apify retrieval adapter (#200). It is the first automatic
# sold-comp candidate only when explicitly enabled AND APIFY_TOKEN is present;
# otherwise routing stays on the public provider below. Leave disabled until the
# owner approves production activation and current Actor pricing/build validation.
APIFY_TOKEN=
# APIFY_SOLD_ENABLED=false
# APIFY_SOLD_ACTOR_BUILD=1.18.3
# Retrieval is fixed at 10 candidates, then one 20-candidate expansion only when
# fewer than three canonical matches survive. Remaining safety knobs may only
# tighten their in-code ceilings: 90-day default window (180 max), 55s run
# timeout, 60s wait, 2 post-run read retries, $0.11/run. The paid Actor-start
# request itself is never retried. Paid retrieval also requires the shared
# Upstash cache above; if its atomic cost fence is unavailable, Apify declines.
# APIFY_SOLD_DAYS_TO_SCRAPE=90
# APIFY_SOLD_TIMEOUT_SECS=55
# APIFY_SOLD_WAIT_SECS=60
# APIFY_SOLD_REQUEST_RETRIES=2
# APIFY_SOLD_MAX_TOTAL_CHARGE_USD=0.11
# APIFY_SOLD_CLAIM_AUTHORITY_WINDOW_MS=15000

# Read-only price research over eBay's PUBLIC sold/completed pages. On by default.
# Set to false/0/off to disable the tier (router then degrades to web search).
# EBAY_SOLD_ENABLED=false
# Overridable for testing; the SSRF guard restricts every eBay target to https *.ebay.com.
# EBAY_SOLD_BASE_URL=https://www.ebay.com
# EBAY_SOLD_USER_AGENT=
# OPTIONAL hosted-egress seam. Missing/blank keeps direct fetch; a configured
# value must be an absolute HTTPS URL with exactly one {url} placeholder. Put the
# real provider template only in local/deploy secrets, never in this file or logs.
# Full validation rules and the zero-request/operator smoke: docs/sold-comps-egress.md
# EBAY_SOLD_PROXY_TEMPLATE=https://proxy.example/fetch?url={url}
# Freshness (#59), all optional with sane defaults. TTL cache of sold-comp scrapes
# (reuse a pull for a few days; cuts scrape footprint — backed by Upstash when set,
# else per-instance in-memory). Staleness cutoff drops sales older than N days; the
# half-life sets how fast a sale's influence on the suggested price decays.
# EBAY_SOLD_CACHE_TTL_HOURS=72
# EBAY_SOLD_STALE_DAYS=180
# EBAY_SOLD_HALFLIFE_DAYS=45

# --- Supabase (required) ---
# From `pnpm supabase start` (local) or the Supabase dashboard (hosted).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use the current `sb_secret_...` key. `SUPABASE_SECRET_KEY` is required in
# deployed environments for account erasure. Keep `SUPABASE_SERVICE_ROLE_KEY`
# only for legacy callers that still read that name; it does not replace the
# account-erasure key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (identity provider; required to sign in) ---
# From https://dashboard.clerk.com → your app → API keys. Supabase must list
# your Clerk instance as a third-party auth provider (hosted: dashboard →
# Authentication → Third-party; local: [auth.third_party.clerk] in
# supabase/config.toml) so Clerk session tokens satisfy RLS.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Native SwiftUI uses the same public Clerk instance through ClerkKit. Supply
# this as an Xcode build setting; it is embedded as a non-secret Info value.
SNAPLIST_CLERK_PUBLISHABLE_KEY=
# The native archive also needs an HTTPS API origin Xcode build setting. Xcode
# embeds this public value as SnapListAPIOrigin; local HTTP is Debug-only and
# must be supplied explicitly rather than becoming an installed-build default.
SNAPLIST_API_ORIGIN=
# When an azp claim is present, accept only these comma-separated origins.
# Supabase's role=authenticated claim is not a JWT audience claim. Localhost is
# valid only for local/test; deployed envs require at least one production HTTPS
# origin, for example `https://snaplist.vercel.app`.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3001
# Production example: CLERK_AUTHORIZED_PARTIES=https://snaplist.vercel.app

# --- Marketing site support channel (optional) ---
# When unset or invalid, the marketing site renders no support email link
# and shows an explicit "not live yet" notice instead.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- PostHog account erasure (server-only; required for account deletion) ---
# Use the private app host and numeric project ID from PostHog. The personal API
# key needs person:read and person:write. Never use the public phc_ project token.
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# --- eBay adapter (sandbox by default; flip to production by changing these) ---
# Sandbox <-> production is CONFIG-ONLY: deployed environments must set
# EBAY_BASE_URL explicitly. When EBAY_PRODUCTION_MOBILE_ENABLED=true it must be
# exactly https://api.ebay.com. Swap credentials/policy ids for production; no
# code change. Full setup walkthrough: docs/ebay-sandbox.md.
EBAY_BASE_URL=https://api.sandbox.ebay.com
# EBAY_PRODUCTION_MOBILE_ENABLED=false
# Commerce Media uses eBay's `apim` host. Omit to derive Sandbox/Production
# from EBAY_BASE_URL; an override is accepted only for these official origins.
# EBAY_MEDIA_BASE_URL=https://apim.sandbox.ebay.com
# External write and token-refresh deadlines (milliseconds). Provider dispatch
# is capped at four minutes; token refresh is capped at two minutes.
EBAY_PROVIDER_DISPATCH_TIMEOUT_MS=240000
EBAY_TOKEN_REFRESH_TIMEOUT_MS=30000
# Trading member-messaging configuration (issue #133). Version/site defaults
# match the documented US Sandbox examples. Sync windows overlap deliberately;
# identity constraints make replay safe.
# EBAY_TRADING_API_VERSION=1455
# EBAY_SITE_ID=0
# EBAY_MESSAGE_SYNC_OVERLAP_MINUTES=1440  # minimum: 1440 (24 hours)
# EBAY_MESSAGE_INITIAL_LOOKBACK_MINUTES=1440

# Transactional eBay auth. Connected sellers use their own encrypted OAuth
# grants; the app-level values below are only the restricted operator Sandbox
# fallback bound by both EBAY_MESSAGING_SANDBOX_OPERATOR_* variables.
# EITHER paste a pre-minted user access token (quick sandbox testing, ~2h TTL):
EBAY_OAUTH_TOKEN=
# OR provide the app keypair + a refresh token minted once via the
# authorization-code flow for the (sandbox) seller account:
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
# App-level Sandbox credentials may be used only by this explicitly configured
# Clerk tenant and stable Sandbox seller identity. Leave either blank to disable
# the fallback; it is never used in production.
EBAY_MESSAGING_SANDBOX_OPERATOR_USER_ID=
EBAY_MESSAGING_SANDBOX_OPERATOR_SELLER_ID=

# Per-user OAuth. The web Settings callback was removed with its route; the
# native flow overlays EBAY_RU_NAME with EBAY_MOBILE_RU_NAME before the shared
# helpers run, so EBAY_MOBILE_RU_NAME is the one that must be configured.
EBAY_RU_NAME=
# RuName = the keyset's "Redirect URL name" in the eBay developer portal; its
# auth-accepted URL must be https://<host>/v1/ebay/oauth/callback. Required for
# mobile OAuth, which is the only OAuth entry point that ships.
EBAY_MOBILE_RU_NAME=
# HTTPS universal link used after the server callback returns its redacted result.
# Credentials and URL fragments are rejected.
EBAY_MOBILE_OAUTH_RETURN_URL=
# 32-byte base64 key for encrypting stored seller tokens: `openssl rand -base64 32`
EBAY_TOKEN_ENCRYPTION_KEY=

# Marketplace + the seller's business policies (required to publish offers).
# Create these on the sandbox seller account (Seller Hub or the Account API)
# and paste the ids; see docs/ebay-sandbox.md.
EBAY_MARKETPLACE_ID=EBAY_US
# Optional: override the offer currency (defaults to the marketplace currency, e.g. EBAY_GB -> GBP)
# EBAY_CURRENCY=USD
# Optional: override the Content-Language locale (defaults to the marketplace locale, e.g. EBAY_DE -> de-DE)
# EBAY_CONTENT_LANGUAGE=nl-BE
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
# Default leaf category for offers until real category resolution lands
# (falls back to eBay's generic "Everything Else > Other" when blank).
EBAY_DEFAULT_CATEGORY_ID=

# eBay Marketplace Account Deletion endpoint (production flip only; leave blank in sandbox).
# EBAY_DELETION_ENDPOINT_URL must match the URL registered in the eBay dev console byte-for-byte.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=

# Inbox synchronization and the inactive-by-default durable-pipeline
# worker/maintenance routes. CRON_SECRET authenticates all of them; with it
# unset every route refuses to run. Applying migrations never creates the
# pipeline schedules. Owner-only activation and rollback:
# docs/runbooks/durable-pipeline-operations.md
# Setting this no longer arms an autonomous marketplace action — the repricing
# sweep it also gated was removed in #591.
# Generate:
# `openssl rand -hex 32`
CRON_SECRET=
# Guest recovery encrypts the ready draft and private photo copies before the
# atomic worker completion. Keep this canonical 32-byte Base64 key stable while
# any recovery using its key id remains inside the 24-hour window.
GUEST_RECOVERY_ENCRYPTION_KEY=
GUEST_RECOVERY_ENCRYPTION_KEY_ID=
# JSON object of retired key-id to canonical 32-byte Base64 key. Keep each
# retired entry through the 24-hour window and until no live recovery names it.
GUEST_RECOVERY_DECRYPTION_KEYS={}
