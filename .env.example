# Copy to .env.local and fill in. Never commit real secrets (see .gitignore).

# --- LLM provider registry (at least one provider key required) ---
# Provider is a config flip (issue #55): dev defaults to Gemini (free tier), the
# showcase runs on OpenAI. LLM_PROVIDER overrides the NODE_ENV default.
# LLM_PROVIDER=gemini        # gemini|google | openai (default: gemini in dev, openai in prod)
OPENAI_API_KEY=              # required for the showcase / when LLM_PROVIDER=openai
GOOGLE_GENERATIVE_AI_API_KEY=  # required for dev / when LLM_PROVIDER=gemini (or GEMINI_API_KEY)
# GEMINI_API_KEY=            # accepted as an alias for GOOGLE_GENERATIVE_AI_API_KEY
# Per-role model id overrides (optional; must match the active provider):
# VISION_MODEL=  LISTING_MODEL=  EXPORT_PACK_MODEL=  PRICING_MODEL=  EVAL_JUDGE_MODEL=  REPLY_MODEL=

# --- Web search (pricing research agent; at least one recommended) ---
TAVILY_API_KEY=
EXA_API_KEY=

# --- Observability: Sentry error tracking (issue #62; OPTIONAL, DSN-gated) ---
# With no DSN, Sentry is inert and structured logging still runs. Set the DSN in
# the deploy env to activate grouped, alerted error capture.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production   # defaults to NODE_ENV

# --- Abuse & cost protection (issue #58; OPTIONAL) ---
# Upstash Redis powers rate limiting + the daily spend guardrail. With both unset,
# an in-memory fallback keeps dev/offline working (per-instance, not shared).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Limit overrides (sensible defaults in src/lib/abuse/config.ts):
# RATE_LIMIT_FREE_PER_MINUTE=20   # metered AI/API requests per minute (free tier)
# QUOTA_FREE_ITEMS_PER_DAY=15     # items processed per day (free tier)
# OPENAI_DAILY_CALL_BUDGET=1000   # global daily pipeline-run budget (alert only)

# --- Billing: freemium subscriptions via direct Stripe (issue #64; OPTIONAL, TEST MODE) ---
# All Stripe TEST keys. With these unset the /api/billing routes return 503 and
# getEntitlement reports everyone `free` (the app + offline tests run without them).
# Going live later is a key swap. Redirect URLs derive from the request origin.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` or the dashboard webhook
# STRIPE_PRICE_PRO=price_...        # the Pro plan's price id (single paid tier)

# --- eBay sold-listings scraper (pricing tier "ebay-sold"; no key, no auth) ---
# OPTIONAL Caffein Apify retrieval adapter (#200). It is the first automatic
# sold-comp candidate only when explicitly enabled AND APIFY_TOKEN is present;
# otherwise routing stays on the public provider below. Leave disabled until the
# owner approves production activation and current Actor pricing/build validation.
APIFY_TOKEN=
# APIFY_SOLD_ENABLED=false
# APIFY_SOLD_ACTOR_BUILD=1.18.3
# Safety knobs may only tighten their in-code ceilings: 25 rows, 90-day default
# window (180 max), 55s run timeout, 60s wait, 2 post-run read retries,
# $0.11/run. The paid Actor-start request itself is never retried.
# APIFY_SOLD_MAX_RESULTS=25
# APIFY_SOLD_DAYS_TO_SCRAPE=90
# APIFY_SOLD_TIMEOUT_SECS=55
# APIFY_SOLD_WAIT_SECS=60
# APIFY_SOLD_REQUEST_RETRIES=2
# APIFY_SOLD_MAX_TOTAL_CHARGE_USD=0.11

# Read-only price research over eBay's PUBLIC sold/completed pages. On by default.
# Set to false/0/off to disable the tier (router then degrades to web search).
# EBAY_SOLD_ENABLED=false
# Overridable for testing; the SSRF guard restricts every eBay target to https *.ebay.com.
# EBAY_SOLD_BASE_URL=https://www.ebay.com
# EBAY_SOLD_USER_AGENT=
# OPTIONAL hosted-egress seam. Missing/blank keeps direct fetch; a configured
# value must be an absolute HTTPS URL with exactly one {url} placeholder. Put the
# real provider template only in local/deploy secrets, never in this file or logs.
# Full validation rules and the zero-request/operator smoke: docs/sold-comps-egress.md
# EBAY_SOLD_PROXY_TEMPLATE=https://proxy.example/fetch?url={url}
# Freshness (#59), all optional with sane defaults. TTL cache of sold-comp scrapes
# (reuse a pull for a few days; cuts scrape footprint — backed by Upstash when set,
# else per-instance in-memory). Staleness cutoff drops sales older than N days; the
# half-life sets how fast a sale's influence on the suggested price decays.
# EBAY_SOLD_CACHE_TTL_HOURS=72
# EBAY_SOLD_STALE_DAYS=180
# EBAY_SOLD_HALFLIFE_DAYS=45

# --- Supabase (required) ---
# From `pnpm supabase start` (local) or the Supabase dashboard (hosted).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use the current `sb_secret_...` key. Legacy JWT-style service-role keys do not
# satisfy the tenant-bound eBay server-write gate.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (identity provider; required to sign in) ---
# From https://dashboard.clerk.com → your app → API keys. Supabase must list
# your Clerk instance as a third-party auth provider (hosted: dashboard →
# Authentication → Third-party; local: [auth.third_party.clerk] in
# supabase/config.toml) so Clerk session tokens satisfy RLS.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- eBay adapter (sandbox by default; flip to production by changing these) ---
# Sandbox <-> production is CONFIG-ONLY: change EBAY_BASE_URL to
# https://api.ebay.com and swap the credentials/policy ids below for production
# ones. No code change. Full setup walkthrough: docs/ebay-sandbox.md.
EBAY_BASE_URL=https://api.sandbox.ebay.com
# Commerce Media uses eBay's `apim` host. Omit to derive Sandbox/Production
# from EBAY_BASE_URL; an override is accepted only for these official origins.
# EBAY_MEDIA_BASE_URL=https://apim.sandbox.ebay.com
# External write and token-refresh deadlines (milliseconds). Provider dispatch
# is capped at four minutes; token refresh is capped at two minutes.
EBAY_PROVIDER_DISPATCH_TIMEOUT_MS=240000
EBAY_TOKEN_REFRESH_TIMEOUT_MS=30000
# Trading member-messaging configuration (issue #133). Version/site defaults
# match the documented US Sandbox examples. Sync windows overlap deliberately;
# identity constraints make replay safe.
# EBAY_TRADING_API_VERSION=1455
# EBAY_SITE_ID=0
# EBAY_MESSAGE_SYNC_OVERLAP_MINUTES=1440  # minimum: 1440 (24 hours)
# EBAY_MESSAGE_INITIAL_LOOKBACK_MINUTES=1440

# Transactional eBay auth. Connected sellers use their own encrypted OAuth
# grants; the app-level values below are only the restricted operator Sandbox
# fallback bound by both EBAY_MESSAGING_SANDBOX_OPERATOR_* variables.
# EITHER paste a pre-minted user access token (quick sandbox testing, ~2h TTL):
EBAY_OAUTH_TOKEN=
# OR provide the app keypair + a refresh token minted once via the
# authorization-code flow for the (sandbox) seller account:
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
# App-level Sandbox credentials may be used only by this explicitly configured
# Clerk tenant and stable Sandbox seller identity. Leave either blank to disable
# the fallback; it is never used in production.
EBAY_MESSAGING_SANDBOX_OPERATOR_USER_ID=
EBAY_MESSAGING_SANDBOX_OPERATOR_SELLER_ID=

# Per-user OAuth (issue #17; required for "Connect eBay" in Settings).
# RuName = the keyset's "Redirect URL name" in the eBay developer portal; its
# auth-accepted URL must be https://<host>/api/ebay/callback.
EBAY_RU_NAME=
# 32-byte base64 key for encrypting stored seller tokens: `openssl rand -base64 32`
EBAY_TOKEN_ENCRYPTION_KEY=

# Marketplace + the seller's business policies (required to publish offers).
# Create these on the sandbox seller account (Seller Hub or the Account API)
# and paste the ids; see docs/ebay-sandbox.md.
EBAY_MARKETPLACE_ID=EBAY_US
# Optional: override the offer currency (defaults to the marketplace currency, e.g. EBAY_GB -> GBP)
# EBAY_CURRENCY=USD
# Optional: override the Content-Language locale (defaults to the marketplace locale, e.g. EBAY_DE -> de-DE)
# EBAY_CONTENT_LANGUAGE=nl-BE
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
# Default leaf category for offers until real category resolution lands
# (falls back to eBay's generic "Everything Else > Other" when blank).
EBAY_DEFAULT_CATEGORY_ID=

# eBay Marketplace Account Deletion endpoint (production flip only; leave blank in sandbox).
# EBAY_DELETION_ENDPOINT_URL must match the URL registered in the eBay dev console byte-for-byte.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=

# Background repricing, inbox synchronization, and the inactive-by-default
# durable-pipeline worker/maintenance routes. CRON_SECRET authenticates all of
# them; with it unset every route refuses to run. Applying migrations never
# creates the pipeline schedules. Owner-only activation and rollback:
# docs/runbooks/durable-pipeline-operations.md
# Generate:
# `openssl rand -hex 32`
CRON_SECRET=
# Optional tuning (defaults: 14-day staleness window, 5 listings per run —
# the scraper spend guardrail — and a 10% material-drift threshold).
# REPRICE_STALE_DAYS=14
# REPRICE_BATCH_SIZE=5
# REPRICE_DRIFT_THRESHOLD_PCT=10
