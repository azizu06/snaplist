// Public native runtime configuration. Scheme environment variables may
// override these values for local testing, but ordinary builds must not depend
// on an unshared scheme.
DEVELOPMENT_TEAM = 35YFS8XJRQ
SNAPLIST_API_ORIGIN = https:/$()/snaplist.dev
SNAPLIST_CLERK_PUBLISHABLE_KEY = pk_test_d2l0dHktd2FscnVzLTI3LmNsZXJrLmFjY291bnRzLmRldiQ
// Public PostHog project key for the `snaplist` project. Like the Clerk
// publishable key it identifies the project to the ingest endpoint and grants
// no read access, so it belongs here rather than in a side channel. Fill it in
// with the project key from PostHog → Settings → Project → Project API key:
//   SNAPLIST_POSTHOG_KEY = phc_YOURPROJECTKEY
// Left empty until the owner fills it in; an empty or unexpanded value makes
// the app build the no-op analytics client instead of a client that cannot
// deliver.
SNAPLIST_POSTHOG_KEY =
// US cloud ingest host. Escape both slashes with $() — xcconfig treats a bare
// // as the start of a comment and would silently truncate the value. This
// follows the existing SNAPLIST_API_ORIGIN line. Only this exact origin is
// reachable: PostHogNetworkGate pins scheme, host, and port, and
// PostHogBatchOnlyURLProtocol allows nothing but /batch.
SNAPLIST_POSTHOG_HOST = https:/$()/us.i.posthog.com
