<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release-only mirror of Info.plist (#971). The two files must otherwise
	     stay identical: this one exists solely to omit the Debug-only
	     NSAppTransportSecurity/NSAllowsLocalNetworking local-networking
	     exception, which App Review flags on a Release build and which
	     Release never needs (HomeRepositoryFactory.resolveAPIOrigin already
	     refuses a loopback API origin outside DEBUG). Wired via
	     SnapList.Release.xcconfig's INFOPLIST_FILE override. When a key
	     changes in Info.plist, mirror the same change here unless it is the
	     ATS exception itself. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SnapList</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>dev.snaplist.ios.runs</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>snaplist</string>
			</array>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance. SnapList's only cryptography is HTTPS to its own
	     API and to its providers, which is exempt, so App Store Connect needs
	     no per-upload answer. Without this key every upload sits in "Missing
	     Compliance" and cannot be submitted. Flipping it to true obliges a
	     CCATS filing and an annual self-classification report; see
	     ios/Scripts/release-config-contract.test.sh. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAccentColorName</key>
	<string>AccentColor</string>
	<key>NSCameraUsageDescription</key>
	<string>Take photos of your item so SnapList can identify it, price it, and write your listing. Photos are uploaded and kept with the listing.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a short voice note about your item. SnapList uploads it, turns it into text for your listing, then deletes the recording.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save your prepared listing photos to your library when you choose Save photos. SnapList only adds photos and never browses your library.</string>
	<key>SnapListAPIOrigin</key>
	<string>$(SNAPLIST_API_ORIGIN)</string>
	<key>SnapListClerkPublishableKey</key>
	<string>$(SNAPLIST_CLERK_PUBLISHABLE_KEY)</string>
	<key>SnapListPostHogHost</key>
	<string>$(SNAPLIST_POSTHOG_HOST)</string>
	<key>SnapListPostHogKey</key>
	<string>$(SNAPLIST_POSTHOG_KEY)</string>
	<key>SnapListSentryDSN</key>
	<string>$(SNAPLIST_SENTRY_DSN)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- SnapList's palette is light-only. SnapListColorToken emits fixed sRGB
	     values with no dark variant, so the canvas token stays #FFFFFF whatever
	     the device appearance is, while the app's semantic .primary and
	     .secondary text does invert. Without this key Dark Mode rendered white
	     labels on those white surfaces and Settings was unreadable. Declaring
	     the app light-only keeps every screen internally consistent for a seller
	     whose device is dark. Remove this key only together with an adaptive
	     palette, which is issue #832. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
