{
  "version": "approved-families-v1",
  "components": {
    "floating_dock": {
      "anatomy": ["Home", "Listings", "central Capture tile", "Inbox", "Insights"],
      "metrics": {"left_right_inset": 14, "bottom": 12, "height": 66, "radius": 26, "icon": 24, "label": 12},
      "material_token": "shadows_and_materials.floating_dock",
      "capture_tile": {"width": 52, "height": 44, "radius": 15, "fill": "#3665F3", "glyph": 25},
      "states": ["selected", "quiet"],
      "rules": ["No Runs tab", "No You tab", "Hide while keyboard is visible", "Home uses aria-current/page equivalent"]
    },
    "top_header": {
      "anatomy": ["SnapList wordmark", "Activity bell", "Account avatar"],
      "metrics": {"status_bar_height": 54, "bell_target": [44, 44], "avatar_target": [44, 44], "badge": [18, 18], "dot": [8, 8]},
      "routes": {"bell": "Activity", "avatar": "Account/Settings"}
    },
    "button": {
      "primary": {"height": 54, "radius": 27, "fill": "#3665F3", "font": {"size": 16, "weight": 700}, "active_scale": 0.99},
      "secondary": {"height": 50, "radius": 25, "border": "1px #D3D6DB", "font": {"size": 15.5, "weight": 600}},
      "tertiary": {"minimum_target": [44, 44], "foreground": "#3665F3"},
      "row_pill": {"minimum_height": 44, "font": {"size": 13, "weight": 600}}
    },
    "seller_row": {
      "thumbnail": {"width": 56, "height": 56, "radius": 12},
      "text": {"title": "row_title", "status_size": 13, "meta_size": 12},
      "divider": {"token": "strokes.divider", "leading_inset": 82},
      "card": {"border": "1px #ECEDEF", "radius": 16},
      "variants": ["attention", "ready_to_finish", "recent_listing"],
      "status_rule": "Always pair an icon with words."
    },
    "chip": {
      "radius": 999,
      "font": {"size": 12, "weight": 600},
      "padding": {"vertical": 4, "horizontal": 10},
      "variants": {
        "info": {"fill": "#E4ECFF", "foreground": "#3665F3"},
        "evidence_strong_source": {"fill": "#EDF1FD", "foreground": "#0031E9", "implementation_foreground": "#3665F3"},
        "caution": {"fill": "#FBF3E7", "foreground": "#9A6A1B"},
        "neutral": {"fill": "#F2F3F5", "foreground": "#55585C"}
      },
      "filter_target_minimum": [44, 44],
      "selection_rule": "Expose pressed/selected semantics in addition to fill."
    },
    "bottom_sheet": {
      "top_radius": 26,
      "grabber": [38, 5],
      "close_target": [44, 44],
      "scrim": "rgba(16,18,20,0.42)",
      "uses": ["CAP-01 launcher", "marketplace explanation", "sign in", "add cost", "set price"]
    },
    "native_permission_alert": {
      "width": 272,
      "radius": 14,
      "material_token": "shadows_and_materials.permission_alert",
      "action_height": 48,
      "actions": ["Don't Allow", "Allow"],
      "truth_rule": "Never counterfeit a granted camera authorization."
    },
    "pricing_chart": {
      "plot_viewbox_height": 150,
      "plot_y_range": [22, 126],
      "axis_font_size": 12,
      "axis_color": "#6B6E73",
      "suggested_line": "dashed",
      "point_rule": "Every point is a real sold listing represented by the fixture; point count equals stated sold count.",
      "filters": ["30D", "60D", "90D", "All"]
    },
    "pricing_comp_row": {
      "thumbnail": [42, 42],
      "thumbnail_radius": 9,
      "title_size": 13.5,
      "meta_size": 12,
      "price_size": 15,
      "figure_variant": "tabular-nums"
    },
    "camera_guidance": {
      "scene": "edge-to-edge cover",
      "framing": "adaptive corner strokes",
      "feedback": "one restrained blue material pill with icon and words",
      "phrases": ["Move closer", "Whole item is in frame"],
      "forbidden": ["amber ordinary coaching", "green ordinary coaching", "item crop", "letterbox", "photo seam"]
    },
    "scout": {
      "placement": "free-standing beside a separate text bubble",
      "forbidden": ["recolor", "crop", "rotate", "mask", "rectangular background", "routine list row", "dock"],
      "sizes": {"onboarding_hero": 184, "denied": 152, "handoff": 140, "app_icon_mark": 104, "helper": 82, "price_limited": 72}
    },
    "home_in_progress": {
      "fill": "#F7F9FC",
      "border": "#E3E8F2",
      "radius": 16,
      "required": ["item thumbnail", "truthful current stage", "You can leave", "route to run detail"],
      "forbidden": ["fabricated percentage", "fabricated ETA"]
    }
  }
}
