{
  "openapi": "3.1.0",
  "info": {
    "title": "SnapList Mobile API",
    "version": "1.0.0",
    "description": "Provider-neutral HTTP contract for the native SwiftUI client. Contract-only operations are owned by the linked follow-up issue until implemented."
  },
  "servers": [{ "url": "{origin}", "variables": { "origin": { "default": "http://127.0.0.1:3001" } } }],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "x-implementation-status": "proof",
        "responses": { "200": { "description": "Runtime is accepting requests", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthEnvelope" } } } } }
      }
    },
    "/v1/session": {
      "get": {
        "operationId": "getSession",
        "x-implementation-status": "proof",
        "security": [{ "ClerkBearer": [] }],
        "responses": {
          "200": { "description": "Verified Clerk subject used by Supabase RLS", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/home": {
      "get": {
        "operationId": "getHome",
        "x-owner-issue": 208,
        "x-implementation-status": "implemented",
        "security": [{ "ClerkBearer": [] }],
        "responses": {
          "200": { "description": "Tenant-scoped Seller Home projection from durable server truth", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HomeEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "description": "The read-only Home projection is temporarily unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/guest/attestations": {
      "post": {
        "operationId": "verifyGuestAttestation",
        "x-owner-issue": 174,
        "x-implementation-status": "contract-only",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["attestation", "challenge"], "properties": { "attestation": { "type": "string" }, "challenge": { "type": "string" } } } } } },
        "responses": { "202": { "description": "Attestation accepted for server verification", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestAttestationEnvelope" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" } }
      }
    },
    "/v1/guest/claims": {
      "post": {
        "operationId": "claimGuestDraft",
        "x-owner-issue": 175,
        "x-related-owner-issues": [174, 181],
        "x-implementation-status": "implemented",
        "security": [{ "ClerkBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "name": "X-SnapList-Guest-Handoff", "in": "header", "required": true, "schema": { "type": "string" }, "description": "Opaque handoff verified by issue #174. It contains no client-defined deadline or account owner." }],
        "responses": {
          "200": { "description": "Stable claimed or expired outcome. Either terminal outcome requires local encrypted recovery deletion.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestClaimEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/InvalidRequest" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/items/runs": {
      "post": {
        "operationId": "createItemRun",
        "x-owner-issue": 159,
        "x-related-owner-issues": [168, 174],
        "x-implementation-status": "contract-only",
        "security": [{ "ClerkBearer": [] }, { "GuestBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRunRequest" } } } },
        "responses": {
          "202": { "description": "Run durably staged and enqueued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunEnvelope" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "description": "Idempotency key conflicts with another request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/runs/{runId}": {
      "parameters": [{ "$ref": "#/components/parameters/RunId" }],
      "get": {
        "operationId": "getRun",
        "x-owner-issue": 159,
        "x-implementation-status": "contract-only",
        "security": [{ "ClerkBearer": [] }, { "GuestBearer": [] }],
        "responses": { "200": { "description": "Tenant-owned durable run", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunEnvelope" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/v1/runs/{runId}/retry": {
      "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
      "post": {
        "operationId": "retryRun",
        "x-owner-issue": 161,
        "x-related-owner-issues": [168],
        "x-implementation-status": "contract-only",
        "security": [{ "ClerkBearer": [] }, { "GuestBearer": [] }],
        "responses": { "202": { "description": "Legal retry transition accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunEnvelope" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "409": { "$ref": "#/components/responses/InvalidRequest" } }
      }
    },
    "/v1/runs/{runId}/cancel": {
      "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
      "post": {
        "operationId": "cancelRun",
        "x-owner-issue": 161,
        "x-related-owner-issues": [168],
        "x-implementation-status": "contract-only",
        "security": [{ "ClerkBearer": [] }, { "GuestBearer": [] }],
        "responses": { "200": { "description": "Legal cancellation transition applied", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunEnvelope" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "409": { "$ref": "#/components/responses/InvalidRequest" } }
      }
    },
    "/v1/billing/revenuecat/identity": {
      "post": {
        "operationId": "bindRevenueCatIdentity",
        "x-owner-issue": 173,
        "x-implementation-status": "implemented",
        "security": [{ "ClerkBearer": [] }],
        "responses": { "200": { "description": "Server-bound RevenueCat configuration for the verified Clerk principal; no request user id is accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevenueCatConfigurationEnvelope" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/entitlements/ai-items": {
      "get": {
        "operationId": "getAiItemEntitlement",
        "x-owner-issue": 168,
        "x-related-owner-issues": [173],
        "x-implementation-status": "implemented",
        "security": [{ "ClerkBearer": [] }],
        "responses": { "200": { "description": "Server-authoritative allowance period and remaining items", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AiItemEntitlementEnvelope" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/ebay/oauth/sessions": {
      "post": {
        "operationId": "createEbayOauthSession",
        "x-owner-issue": 17,
        "x-implementation-status": "contract-only",
        "security": [{ "ClerkBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "201": { "description": "Server-created OAuth state and authorization URL; provider tokens never transit SwiftUI", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EbayOauthSessionEnvelope" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/v1/ebay/oauth/callback": {
      "get": {
        "operationId": "completeEbayOauthCallback",
        "x-owner-issue": 17,
        "x-implementation-status": "contract-only",
        "parameters": [
          { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "error", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "303": { "description": "Redirects to an app universal link carrying only an opaque completion result" }, "400": { "$ref": "#/components/responses/InvalidRequest" } }
      }
    },
    "/v1/webhooks/revenuecat": {
      "post": {
        "operationId": "receiveRevenueCatWebhook",
        "x-owner-issue": 173,
        "x-implementation-status": "implemented",
        "parameters": [
          { "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string" }, "description": "Operator-configured exact secret value" },
          { "name": "X-RevenueCat-Webhook-Signature", "in": "header", "required": true, "schema": { "type": "string" }, "description": "HMAC timestamp and digest over the raw JSON body" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "description": "RevenueCat lifecycle event; verified before tenant mapping or parsing" } } } },
        "responses": { "200": { "description": "Verified and applied, reconciled, duplicated, or intentionally ignored" }, "400": { "$ref": "#/components/responses/InvalidRequest" } }
      }
    },
    "/internal/v1/pipeline/consume": {
      "post": {
        "operationId": "consumePipelineQueue",
        "x-owner-issue": 162,
        "x-implementation-status": "proof",
        "security": [{ "InternalBearer": [] }],
        "responses": { "200": { "description": "One bounded consume pass", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkerSummaryEnvelope" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ClerkBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Server verifies Clerk issuer, signature, expiry, and subject, and enforces configured authorized-party validation when an azp claim is present. The same token is forwarded only to an RLS-scoped Supabase client." },
      "GuestBearer": { "type": "http", "scheme": "bearer", "description": "Opaque, short-lived guest capability minted only after App Attest verification." },
      "InternalBearer": { "type": "http", "scheme": "bearer", "description": "Scheduler/worker secret or stronger platform identity; never available to SwiftUI." }
    },
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Stable per logical mutation; replay returns the original result and never creates another run, credit, or provider action." },
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Unauthorized": { "description": "Missing or invalid authentication", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "InvalidRequest": { "description": "Invalid or illegal state transition", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "Unavailable": { "description": "The server could not complete the operation safely; retry is permitted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "NotFound": { "description": "Resource absent or hidden by tenant isolation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    },
    "schemas": {
      "ErrorEnvelope": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message", "requestId"], "properties": { "code": { "type": "string", "enum": ["unauthorized", "forbidden", "invalid_request", "not_found", "method_not_allowed", "conflict", "rate_limited", "internal_error"] }, "message": { "type": "string" }, "requestId": { "type": "string" }, "details": { "type": "object", "additionalProperties": true } } } } },
      "HealthEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "object", "required": ["apiVersion", "status"], "properties": { "apiVersion": { "const": "v1" }, "status": { "const": "ok" } } }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "SessionEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "object", "required": ["userId"], "properties": { "userId": { "type": "string" } } }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "HomeEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "$ref": "#/components/schemas/HomeProjection" }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "HomeProjection": { "type": "object", "additionalProperties": false, "required": ["revision", "sellerState", "unreadNotificationCount", "summary", "attention", "currentRun", "readyToFinish", "listings", "recentSearches"], "properties": { "revision": { "type": "integer", "minimum": 0 }, "sellerState": { "type": "string", "enum": ["active", "newSeller"] }, "unreadNotificationCount": { "type": "integer", "minimum": 0 }, "summary": { "$ref": "#/components/schemas/HomeSummary" }, "attention": { "type": "array", "items": { "$ref": "#/components/schemas/HomeAttentionTask" } }, "currentRun": { "oneOf": [{ "$ref": "#/components/schemas/HomeCurrentRun" }, { "type": "null" }] }, "readyToFinish": { "type": "array", "items": { "$ref": "#/components/schemas/HomeFinishItem" } }, "listings": { "type": "array", "items": { "$ref": "#/components/schemas/HomeListing" } }, "recentSearches": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
      "HomeSummary": { "type": "object", "additionalProperties": false, "required": ["active", "drafts", "orders"], "properties": { "active": { "type": "integer", "minimum": 0 }, "drafts": { "type": "integer", "minimum": 0 }, "orders": { "type": ["integer", "null"], "minimum": 0 } } },
      "HomeAttentionTask": { "type": "object", "additionalProperties": false, "required": ["id", "itemTitle", "kind", "status", "detail", "actionLabel", "destination"], "properties": { "id": { "type": "string", "format": "uuid" }, "itemTitle": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["shipping", "message", "offer", "warning", "pricing"] }, "status": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "actionLabel": { "type": "string", "minLength": 1 }, "destination": { "$ref": "#/components/schemas/HomeDestination" } } },
      "HomeDestination": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "type": "string", "enum": ["order", "conversation", "publishIssue", "draft"] }, "id": { "type": "string", "format": "uuid" } } },
      "HomeCurrentRun": { "type": "object", "additionalProperties": false, "required": ["id", "itemTitle", "stageLabel", "reassurance", "progress"], "properties": { "id": { "type": "string", "format": "uuid" }, "itemTitle": { "type": "string", "minLength": 1 }, "stageLabel": { "type": "string", "minLength": 1 }, "reassurance": { "type": "string", "minLength": 1 }, "progress": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } } },
      "HomeFinishItem": { "type": "object", "additionalProperties": false, "required": ["id", "title", "detail"], "properties": { "id": { "type": "string", "format": "uuid" }, "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 } } },
      "HomeListing": { "type": "object", "additionalProperties": false, "required": ["id", "title", "lifecycle", "statusLabel", "detail", "price"], "properties": { "id": { "type": "string", "format": "uuid" }, "title": { "type": "string", "minLength": 1 }, "lifecycle": { "type": "string", "enum": ["active", "draft", "sold", "needsAttention"] }, "statusLabel": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "price": { "type": ["string", "null"] } } },
      "GuestAttestationEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "object", "required": ["attestationId", "status"], "properties": { "attestationId": { "type": "string", "format": "uuid" }, "status": { "const": "pending_verification" } } }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "GuestClaimEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "object", "required": ["outcome", "itemId", "runId", "draftId", "purgeLocalRecovery"], "properties": { "outcome": { "type": "string", "enum": ["claimed", "expired"] }, "itemId": { "type": "string", "format": "uuid" }, "runId": { "type": "string", "format": "uuid" }, "draftId": { "type": "string", "format": "uuid" }, "purgeLocalRecovery": { "const": true } }, "additionalProperties": false }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "RevenueCatConfigurationEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "object", "required": ["configured", "appUserId"], "properties": { "configured": { "type": "boolean" }, "appUserId": { "type": "string" }, "publicSdkKey": { "type": "string" }, "entitlementId": { "type": "string" }, "monthlyProductId": { "type": "string" }, "offeringId": { "type": "string" }, "transitionState": { "type": "string", "enum": ["not_required", "required", "reconciled"] }, "legacyStripeStatus": { "type": ["string", "null"] } } }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "AiItemEntitlementEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "object", "required": ["billingSource", "status", "remainingItems", "periodStart", "periodEnd", "gracePeriodEnd", "transitionState", "legacyStripeStatus"], "properties": { "billingSource": { "type": "string", "enum": ["included", "storekit", "none"] }, "status": { "type": "string", "enum": ["included", "active", "grace", "billing_retry", "expired", "revoked", "refunded", "ambiguous", "unconfigured"] }, "remainingItems": { "type": "integer", "minimum": 0 }, "periodStart": { "type": ["string", "null"], "format": "date-time" }, "periodEnd": { "type": ["string", "null"], "format": "date-time" }, "gracePeriodEnd": { "type": ["string", "null"], "format": "date-time" }, "transitionState": { "type": ["string", "null"], "enum": ["not_required", "required", "reconciled", null] }, "legacyStripeStatus": { "type": ["string", "null"] } } }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "EbayOauthSessionEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "object", "required": ["sessionId", "authorizationUrl", "expiresAt"], "properties": { "sessionId": { "type": "string", "format": "uuid" }, "authorizationUrl": { "type": "string", "format": "uri" }, "expiresAt": { "type": "string", "format": "date-time" } } }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "ResponseMeta": { "type": "object", "required": ["requestId"], "properties": { "requestId": { "type": "string" } } },
      "CreateRunRequest": { "type": "object", "required": ["photoObjectPaths", "photoSetFingerprint"], "properties": { "photoObjectPaths": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string" } }, "photoSetFingerprint": { "type": "string" }, "costBasis": { "type": ["number", "null"], "minimum": 0 } }, "additionalProperties": false },
      "RunEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "$ref": "#/components/schemas/PipelineRun" }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "PipelineRun": { "type": "object", "required": ["id", "status", "stage", "attemptCount", "schemaVersion"], "properties": { "id": { "type": "string", "format": "uuid" }, "status": { "type": "string", "enum": ["queued", "running", "retrying", "succeeded", "failed", "canceled"] }, "stage": { "type": "string", "enum": ["queued", "identifying", "pricing", "generating", "persisting", "completed"] }, "attemptCount": { "type": "integer", "minimum": 0 }, "schemaVersion": { "const": 1 }, "safeFailure": { "type": ["object", "null"] } } },
      "WorkerSummaryEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "$ref": "#/components/schemas/WorkerSummary" }, "meta": { "$ref": "#/components/schemas/ResponseMeta" } } },
      "WorkerSummary": { "type": "object", "required": ["claimed", "succeeded", "retrying", "failed", "skipped"], "properties": { "claimed": { "type": "integer", "minimum": 0 }, "succeeded": { "type": "integer", "minimum": 0 }, "retrying": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 }, "skipped": { "type": "integer", "minimum": 0 } } }
    }
  }
}
